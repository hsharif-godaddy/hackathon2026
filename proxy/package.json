{
  "name": "airo-proxy",
  "version": "2.0.0",
  "description": "Getty Images API Proxy with SSO Authentication",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "NODE_ENV=development LOG_LEVEL=debug tsx watch src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix src/",
    "typecheck": "tsc --noEmit"
  },
  "author": "Airo Team",
  "license": "MIT",
  "dependencies": {
    "express": "catalog:",
    "form-data": "^4.0.5",
    "gd-auth-client": "catalog:",
    "helmet": "catalog:",
    "multer": "catalog:",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@airo/eslint-config": "workspace:*",
    "@types/express": "catalog:",
    "@types/multer": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "eslint": "catalog:",
    "supertest": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
