{
  "name": "airo-proxy",
  "version": "2.0.0",
  "description": "Getty Images API Proxy with SSO Authentication",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "NODE_ENV=development LOG_LEVEL=debug tsx watch src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "typecheck": "tsc --noEmit"
  },
  "author": "Airo Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.22.1",
    "form-data": "^4.0.5",
    "gd-auth-client": "^2.1.1",
    "helmet": "^8.0.0",
    "multer": "^2.1.1",
    "pino": "^9.6.0",
    "pino-http": "^10.3.0"
  },
  "devDependencies": {
    "@airo/eslint-config": "workspace:*",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.18.12",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
