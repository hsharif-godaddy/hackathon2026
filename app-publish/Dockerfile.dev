ARG UPSTREAM_VERSION=22

# =================================================================
# Build dev-supervisor stage
# =================================================================
FROM golang:1.25-alpine AS dev-supervisor-builder

USER root

# Install build dependencies
RUN apk add --no-cache git make ca-certificates tzdata

WORKDIR /build

# Copy go mod files from build context
# dev-supervisor is mounted as a build context by docker-container-manager
COPY --from=dev-supervisor go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code from build context
COPY --from=dev-supervisor . .

# Build binary with static linking for Alpine
RUN CGO_ENABLED=0 GOOS=linux go build -a -ldflags '-extldflags "-static" -w -s' -o dev-supervisor .

# =================================================================
# Build publish app stage
# =================================================================
FROM node:${UPSTREAM_VERSION}-alpine

USER root

# Accept build arguments for dynamic UID/GID mapping (same as preview Dockerfile)
ARG HOST_UID=790
ARG HOST_GID=790

# Install runtime dependencies
# Publish image only extracts pre-built tarballs - no compilation needed
RUN apk add --no-cache curl git ca-certificates tzdata bash jq yq ripgrep

# Create the group and user with dynamic UID/GID
# This allows the container user to match the host user for proper file permissions
# Validate and adjust GID if it's outside Alpine's supported range (0-256000)
RUN CONTAINER_GID=${HOST_GID}; \
    if [ ${HOST_GID} -gt 256000 ]; then \
        echo "Host GID ${HOST_GID} exceeds Alpine limit, using fallback GID 1000"; \
        CONTAINER_GID=1000; \
    fi; \
    if getent group $CONTAINER_GID >/dev/null 2>&1; then \
        echo "GID $CONTAINER_GID is already in use, reassigning to GID 9999"; \
        sed -i "/^[^:]*:[^:]*:$CONTAINER_GID:/s/:$CONTAINER_GID:/:9999:/" /etc/group; \
    fi; \
    addgroup -g $CONTAINER_GID agent

# Validate and adjust UID if it's outside Alpine's supported range
RUN CONTAINER_UID=${HOST_UID}; \
    if [ ${HOST_UID} -gt 256000 ]; then \
        echo "Host UID ${HOST_UID} exceeds Alpine limit, using fallback UID 1000"; \
        CONTAINER_UID=1000; \
    fi; \
    if getent passwd $CONTAINER_UID >/dev/null 2>&1; then \
        echo "UID $CONTAINER_UID is already in use, reassigning to UID 9999"; \
        sed -i "/^[^:]*:[^:]*:$CONTAINER_UID:/s/:$CONTAINER_UID:/:9999:/" /etc/passwd; \
    fi; \
    adduser -D -G agent -u $CONTAINER_UID agent

# Copy dev-supervisor binary from builder stage
COPY --chown=agent:agent --from=dev-supervisor-builder /build/dev-supervisor /usr/local/bin/dev-supervisor

# Copy publish scripts from main build context (app-publish/)
COPY --chown=agent:agent run-app.sh /publish/run-app.sh
COPY --chown=agent:agent coming-soon.js /publish/coming-soon.js

# Enable corepack (for pnpm), create directories, and set permissions
# Pin versions to match project (pnpm@10.17.0) and Node 22 (corepack@0.34.0) for reproducible builds
RUN chmod +x /usr/local/bin/dev-supervisor /publish/run-app.sh && \
    npm install --yes --global corepack@0.34.0 && \
    corepack enable && \
    corepack install --global pnpm@10.17.0 && \
    mkdir -p logs /app /dist && \
    chown -R agent:agent /app /dist /publish logs

# Environment variables for production mode
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    NODE_ENV=production \
    RUNNING_IN_DOCKER=true \
    DIST_DIR=/dist

# Switch to the agent user so we are not running as root
USER agent
WORKDIR /app

# Use dev-supervisor as PID 1 to manage the publish process
ENTRYPOINT ["/usr/local/bin/dev-supervisor"]
CMD ["exec", "/publish/run-app.sh"]
