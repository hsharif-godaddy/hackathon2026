ARG UPSTREAM_VERSION=22

# =================================================================
# Build airo-workspace Rust PID1 binary
# =================================================================
FROM rust:1.96-alpine AS rust-builder

# musl-dev: musl C library for the static binary. gcc: provides libgcc_s
# plus the system C linker. cc (= gcc on Alpine) auto-includes /usr/lib
# and /usr/lib/gcc/... in its search path so proc-macro / build-script
# compiles can resolve -lgcc_s / -lc / -lgcc. Override the per-target
# linker that rust/.cargo/config.toml sets to rust-lld; the cross-compile
# path in CI is unaffected. crt-static stays on by default for the musl
# target, so the final binary is still fully static.
RUN apk add --no-cache musl-dev gcc
ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_LINKER=cc
ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_MUSL_LINKER=cc

WORKDIR /build

COPY --from=dev-supervisor rust/ ./rust/

RUN cd rust && cargo build --release && \
    cp target/release/airo-workspace /usr/local/bin/airo-workspace

# =================================================================
# Build dev-supervisor Go binaries
# =================================================================
FROM golang:1.25-alpine AS dev-supervisor-builder

USER root

# Install build dependencies
RUN apk add --no-cache git make ca-certificates tzdata

WORKDIR /build

# Copy go mod files from build context
# dev-supervisor is mounted as a build context by docker-container-manager
COPY --from=dev-supervisor go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code from build context
COPY --from=dev-supervisor . .

# Build binaries with static linking for Alpine
ARG VERSION=dev
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-w -s -X main.Version=${VERSION}" -o /usr/local/bin/dev-supervisor ./cmd/dev-supervisor
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-w -s" -o /usr/local/bin/airo-sandbox ./cmd/airo-sandbox

# =================================================================
# Build publish app stage
# =================================================================
FROM node:${UPSTREAM_VERSION}-alpine

USER root

# Accept build arguments for dynamic UID/GID mapping (same as preview Dockerfile)
ARG HOST_UID=790
ARG HOST_GID=790

# Install runtime dependencies
# Includes build tools (python3, make, g++) for build-and-run.sh native module compilation
RUN apk add --no-cache curl git ca-certificates tzdata bash jq yq ripgrep python3 py3-setuptools make g++

# Create the group and user with dynamic UID/GID
# This allows the container user to match the host user for proper file permissions
# Validate and adjust GID if it's outside Alpine's supported range (0-256000)
RUN CONTAINER_GID=${HOST_GID}; \
    if [ ${HOST_GID} -gt 256000 ]; then \
        echo "Host GID ${HOST_GID} exceeds Alpine limit, using fallback GID 1000"; \
        CONTAINER_GID=1000; \
    fi; \
    if getent group $CONTAINER_GID >/dev/null 2>&1; then \
        echo "GID $CONTAINER_GID is already in use, reassigning to GID 9999"; \
        sed -i "/^[^:]*:[^:]*:$CONTAINER_GID:/s/:$CONTAINER_GID:/:9999:/" /etc/group; \
    fi; \
    addgroup -g $CONTAINER_GID agent

# Validate and adjust UID if it's outside Alpine's supported range
RUN CONTAINER_UID=${HOST_UID}; \
    if [ ${HOST_UID} -gt 256000 ]; then \
        echo "Host UID ${HOST_UID} exceeds Alpine limit, using fallback UID 1000"; \
        CONTAINER_UID=1000; \
    fi; \
    if getent passwd $CONTAINER_UID >/dev/null 2>&1; then \
        echo "UID $CONTAINER_UID is already in use, reassigning to UID 9999"; \
        sed -i "/^[^:]*:[^:]*:$CONTAINER_UID:/s/:$CONTAINER_UID:/:9999:/" /etc/passwd; \
    fi; \
    adduser -D -G agent -u $CONTAINER_UID agent

# Copy dev-supervisor binaries from builder stages
COPY --chown=agent:agent --from=rust-builder /usr/local/bin/airo-workspace /usr/local/bin/airo-workspace
COPY --chown=agent:agent --from=dev-supervisor-builder /usr/local/bin/dev-supervisor /usr/local/bin/dev-supervisor
COPY --chown=agent:agent --from=dev-supervisor-builder /usr/local/bin/airo-sandbox /usr/local/bin/airo-sandbox

# Copy publish scripts from container-scripts build context (already executable)
COPY --from=container-scripts --chown=agent:agent publish/run-app.sh /publish/run-app.sh
COPY --from=container-scripts --chown=agent:agent publish/build-and-run.sh /publish/build-and-run.sh
COPY --from=container-scripts --chown=agent:agent publish/common.sh /publish/common.sh
COPY --from=container-scripts --chown=agent:agent publish/entrypoint.sh /publish/entrypoint.sh

# Enable corepack (for pnpm), create directories, and set permissions
# Pin versions to match project (pnpm@10.17.0) and Node 22 (corepack@0.34.0) for reproducible builds
RUN \
    npm install --yes --global corepack@0.34.0 && \
    corepack enable && \
    corepack install --global pnpm@10.17.0 && \
    mkdir -p logs /app /dist /local && \
    chown -R agent:agent /app /dist /publish /local logs

# Environment variables for production mode
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    NODE_ENV=production \
    RUNNING_IN_DOCKER=true \
    DIST_DIR=/dist

# Switch to the agent user so we are not running as root
USER agent
WORKDIR /app

# Use dev-supervisor as PID 1 to manage the publish process
ENTRYPOINT ["/usr/local/bin/airo-workspace", "/usr/local/bin/dev-supervisor"]
CMD ["exec", "/publish/run-app.sh"]
