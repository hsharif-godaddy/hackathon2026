{
  "name": "@airo/ai-lib",
  "version": "0.1.0",
  "description": "Lightweight AI SDK wrapper for building reusable agents with AI SDK 5",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./budget": {
      "types": "./dist/budget/index.d.ts",
      "import": "./dist/budget/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "tsc --noEmit --project tsconfig.examples.json",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "example:basic-openai": "npx tsx examples/basic-openai.ts",
    "example:websocket-single": "npx tsx examples/experimental-websocket-demo.ts single",
    "example:websocket-multi": "npx tsx examples/experimental-websocket-demo.ts multi",
    "example:prompt-builder": "npx tsx examples/prompt-builder-demo.ts",
    "example:claude-proxy": "npx tsx examples/claude-proxy-demo.ts",
    "example:tool-hooks": "npx tsx examples/tool-execution-hooks-demo.ts",
    "example:develop-hooks": "npx tsx examples/develop-agent-hooks-example.ts",
    "example:agent-delegation": "npx tsx examples/agent-handoff-demo.ts",
    "example:delegation": "npx tsx examples/develop-database-handoff-example.ts",
    "example:handoff-tool": "npx tsx examples/handoff-tool-example.ts",
    "example:handoff-helpers": "npx tsx examples/handoff-helpers-example.ts",
    "example:s2s-auth": "npx tsx examples/s2s-auth-demo.ts",
    "example:s2s-anthropic": "npx tsx examples/s2s-auth-anthropic-demo.ts",
    "example:s2s-caching": "npx tsx examples/s2s-token-caching-demo.ts",
    "example:s2s-concurrency": "npx tsx examples/s2s-concurrency-test.ts",
    "example:image-generation": "npx tsx examples/image-generation-demo.ts",
    "setup": "echo 'Copy env.example to .env and fill in your API keys, then run npm run example:basic-openai'"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.54",
    "@ai-sdk/openai": "^3.0.49",
    "@ai-sdk/openai-compatible": "^2.0.37",
    "@ai-sdk/provider": "^3.0.8",
    "@airo/ai-common": "workspace:*",
    "@airo/ai-grants": "workspace:*",
    "@airo/shared": "workspace:*",
    "@langfuse/tracing": "^4.6.1",
    "ai": "^6.0.141",
    "ai-tokenizer": "^1.0.6",
    "dotenv": "^16.4.7",
    "gd-auth-client": "^2.1.1",
    "openai": "^6.0.0",
    "undici": "^6.21.3",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@ai-sdk/anthropic": "^3.0.64"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/anthropic": {
      "optional": true
    }
  },
  "devDependencies": {
    "@airo/eslint-config": "workspace:*",
    "@aws-sdk/client-sts": "3.1022.0",
    "@aws-sdk/credential-providers": "3.1022.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.18.12",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "express": "^4.22.1",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "ai",
    "ai-sdk",
    "agents",
    "agent-delegation",
    "agent-handoff",
    "multi-agent",
    "llm",
    "typescript",
    "openai",
    "anthropic",
    "claude",
    "gpt",
    "websocket",
    "socket.io",
    "streaming",
    "real-time"
  ],
  "author": "Airo AI Builder",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
