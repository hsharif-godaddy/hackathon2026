# AI Provider API Keys
# Copy this file to .env and fill in your API keys

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# AWS Bedrock Configuration (optional)
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
# OR use AWS_PROFILE=your_profile_name
# OR use IAM roles in AWS environment

# Example Configuration
# Choose which provider to use in examples
DEFAULT_PROVIDER=openai
# Options: openai, anthropic, bedrock

# Model Configuration
DEFAULT_MODEL=gpt-4o-mini
# OpenAI options: gpt-4o, gpt-4o-mini, gpt-3.5-turbo
# Anthropic options: claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022
# Bedrock options: 
#   us.anthropic.claude-sonnet-4-20250514-v1:0 (Claude Sonnet 4)
#   us.anthropic.claude-3-5-sonnet-20241022-v1:0 (Claude 3.5 Sonnet)
#   us.anthropic.claude-3-5-haiku-20241022-v1:0 (Claude 3.5 Haiku)
