{
  "name": "@airo/logging",
  "version": "0.1.0",
  "description": "Unified logging for Airo App Builder - Pino-backed with schema profiles",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./test": {
      "types": "./dist/test/index.d.ts",
      "import": "./dist/test/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "client": [
        "dist/client/index.d.ts"
      ],
      "test": [
        "dist/test/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "dependencies": {
    "pino": "^9.6.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "@airo/eslint-config": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "author": "Airo AI Builder",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
