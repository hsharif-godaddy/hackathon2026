{
  "name": "@airo/design-extractor",
  "version": "0.1.0",
  "description": "PDF design document extraction tool for RAG pipeline",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "extract": "tsx src/extract.ts",
    "generate-styles": "tsx src/generate-style.ts"
  },
  "dependencies": {
    "@airo/ai-lib": "workspace:*",
    "dotenv": "^16.4.7",
    "pdf2pic": "^3.1.3",
    "pdfjs-dist": "^5.4.149"
  },
  "devDependencies": {
    "@types/node": "^22.18.12",
    "@types/pdf-parse": "^1.1.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "pdf",
    "extraction",
    "rag",
    "design",
    "llm"
  ],
  "author": "Airo AI Builder",
  "license": "MIT"
}
