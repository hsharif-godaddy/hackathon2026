{
  "name": "@airo/design-extractor",
  "version": "0.1.0",
  "description": "PDF design document extraction tool for RAG pipeline",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "extract": "tsx src/extract.ts",
    "generate-styles": "tsx src/generate-style.ts"
  },
  "dependencies": {
    "@airo/ai-lib": "workspace:*",
    "dotenv": "catalog:",
    "pdf2pic": "^3.1.3",
    "pdfjs-dist": "^5.6.205"
  },
  "devDependencies": {
    "@airo/eslint-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pdf-parse": "^1.1.4",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "keywords": [
    "pdf",
    "extraction",
    "rag",
    "design",
    "llm"
  ],
  "author": "Airo AI Builder",
  "license": "MIT"
}
