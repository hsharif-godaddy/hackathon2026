{
  "name": "@airo/shared",
  "version": "0.1.0",
  "description": "Shared types and pure utilities for Airo App Builder",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./grants": {
      "types": "./dist/grants/index.d.ts",
      "import": "./dist/grants/index.js"
    },
    "./context-attachment": {
      "types": "./dist/context-attachment/index.d.ts",
      "import": "./dist/context-attachment/index.js"
    },
    "./websocket": {
      "types": "./dist/websocket/index.d.ts",
      "import": "./dist/websocket/index.js"
    },
    "./social": {
      "types": "./dist/social/index.d.ts",
      "import": "./dist/social/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js"
    },
    "./budget": {
      "types": "./dist/budget/index.d.ts",
      "import": "./dist/budget/index.js"
    },
    "./json": {
      "types": "./dist/json/index.d.ts",
      "import": "./dist/json/index.js"
    },
    "./media": {
      "types": "./dist/media/index.d.ts",
      "import": "./dist/media/index.js"
    },
    "./brand-data": {
      "types": "./dist/brand-data/index.d.ts",
      "import": "./dist/brand-data/index.js"
    },
    "./share-url": {
      "types": "./dist/share-url/index.d.ts",
      "import": "./dist/share-url/index.js"
    },
    "./credit-adapter": {
      "types": "./dist/credit-adapter/index.d.ts",
      "import": "./dist/credit-adapter/index.js"
    },
    "./app-metadata": {
      "types": "./dist/app-metadata/index.d.ts",
      "import": "./dist/app-metadata/index.js"
    },
    "./app-structure": {
      "types": "./dist/app-structure/index.d.ts",
      "import": "./dist/app-structure/index.js"
    },
    "./publish": {
      "types": "./dist/publish/index.d.ts",
      "import": "./dist/publish/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "grants": [
        "dist/grants/index.d.ts"
      ],
      "context-attachment": [
        "dist/context-attachment/index.d.ts"
      ],
      "websocket": [
        "dist/websocket/index.d.ts"
      ],
      "social": [
        "dist/social/index.d.ts"
      ],
      "auth": [
        "dist/auth/index.d.ts"
      ],
      "budget": [
        "dist/budget/index.d.ts"
      ],
      "json": [
        "dist/json/index.d.ts"
      ],
      "media": [
        "dist/media/index.d.ts"
      ],
      "brand-data": [
        "dist/brand-data/index.d.ts"
      ],
      "share-url": [
        "dist/share-url/index.d.ts"
      ],
      "credit-adapter": [
        "dist/credit-adapter/index.d.ts"
      ],
      "app-metadata": [
        "dist/app-metadata/index.d.ts"
      ],
      "app-structure": [
        "dist/app-structure/index.d.ts"
      ],
      "publish": [
        "dist/publish/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "lint:fix": "eslint --fix src/"
  },
  "devDependencies": {
    "@airo/eslint-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "author": "Airo AI Builder",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
