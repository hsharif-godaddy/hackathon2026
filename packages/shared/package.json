{
  "name": "@airo/shared",
  "version": "0.1.0",
  "description": "Shared types and pure utilities for Airo App Builder",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./grants": {
      "types": "./dist/grants/index.d.ts",
      "import": "./dist/grants/index.js"
    },
    "./context-attachment": {
      "types": "./dist/context-attachment/index.d.ts",
      "import": "./dist/context-attachment/index.js"
    },
    "./websocket": {
      "types": "./dist/websocket/index.d.ts",
      "import": "./dist/websocket/index.js"
    },
    "./social": {
      "types": "./dist/social/index.d.ts",
      "import": "./dist/social/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "grants": ["dist/grants/index.d.ts"],
      "context-attachment": ["dist/context-attachment/index.d.ts"],
      "websocket": ["dist/websocket/index.d.ts"],
      "social": ["dist/social/index.d.ts"]
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  },
  "author": "Airo AI Builder",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
