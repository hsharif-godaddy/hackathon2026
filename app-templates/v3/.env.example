# Environment Configuration for V3 App Template

# Node Environment
NODE_ENV=development

# Database Configuration
# These values will be automatically updated by the Database Agent
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=template_v3_template_app

# Database URL (alternative format - will be auto-generated)
DATABASE_URL=mysql://your_db_user:your_db_password@localhost:3306/template_v3_template_app

# Server Configuration
PORT=3000
BACKEND_PORT=3000
FRONTEND_PORT=5173

# Development Configuration
RUNNING_IN_DOCKER=false
PREFERRED_FRONTEND_PORT=5173

# Vite Configuration
VITE_API_URL=/api
VITE_BACKEND_PORT=3000

# Security Configuration (add as needed)
# JWT_SECRET=your_jwt_secret_here
# ENCRYPTION_KEY=your_encryption_key_here

# External Services (add as needed)
# REDIS_URL=redis://localhost:6379
# SMTP_HOST=localhost
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Logging Configuration
LOG_LEVEL=info

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Additional Configuration
# Add your custom environment variables here
