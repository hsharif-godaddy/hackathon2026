# =================================================================
# Stage 0: Build dev-supervisor (CACHED - rarely changes)
# =================================================================
FROM golang:1.25-alpine AS dev-supervisor-builder

# Install build dependencies
RUN apk add --no-cache git make ca-certificates tzdata

WORKDIR /build

# Copy go mod files from build context
COPY --from=dev-supervisor go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code from build context
COPY --from=dev-supervisor . .

# Build binaries with static linking for Alpine
RUN CGO_ENABLED=0 GOOS=linux go build -a -ldflags '-extldflags "-static" -w -s' -o /usr/local/bin/dev-supervisor ./cmd/dev-supervisor
RUN CGO_ENABLED=0 GOOS=linux go build -a -ldflags '-extldflags "-static" -w -s' -o /usr/local/bin/airo-sandbox ./cmd/airo-sandbox

# =================================================================
# Stage 0.5: Prepare gitleaks binary (CACHED - rarely changes)
# =================================================================
FROM alpine:3.22 AS gitleaks-preparer

# Install curl and tar for downloading
RUN apk add --no-cache curl tar gzip

WORKDIR /tmp

# Download gitleaks for Alpine Linux
# Support both x64 and ARM64 architectures
ARG GITLEAKS_VERSION=v8.18.0
ARG TARGETPLATFORM
ARG BUILDPLATFORM

# Detect architecture from TARGETPLATFORM (set by Docker buildx)
# Format: linux/amd64 or linux/arm64
RUN ARCH=$(echo ${TARGETPLATFORM:-linux/amd64} | cut -d'/' -f2) && \
    if [ "$ARCH" = "amd64" ]; then \
        PLATFORM="linux_x64"; \
    elif [ "$ARCH" = "arm64" ]; then \
        PLATFORM="linux_arm64"; \
    else \
        echo "Unsupported architecture: $ARCH" && exit 1; \
    fi && \
    VERSION_FOR_FILENAME=${GITLEAKS_VERSION#v} && \
    curl -L -f "https://github.com/gitleaks/gitleaks/releases/download/${GITLEAKS_VERSION}/gitleaks_${VERSION_FOR_FILENAME}_${PLATFORM}.tar.gz" -o gitleaks.tar.gz && \
    tar -xzf gitleaks.tar.gz && \
    chmod +x gitleaks && \
    mv gitleaks /usr/local/bin/gitleaks && \
    /usr/local/bin/gitleaks version && \
    rm -f gitleaks.tar.gz

# =================================================================
# Stage 1: Dependencies Layer (CACHED - rarely changes)
# =================================================================
FROM node:22-alpine AS deps

# Install system dependencies
RUN apk add --no-cache curl git ca-certificates tzdata bash jq yq ripgrep

# Set working directory for package.json
WORKDIR /app

# Copy ONLY package files for dependency installation
COPY package*.json ./

# Install ALL dependencies (including devDependencies for build)
# This layer is cached and only rebuilt when package files change
# Uses global shared cache across all app builds for maximum efficiency
# sharing=shared allows concurrent access - multiple apps can build in parallel without lock contention
ENV NPM_CONFIG_CACHE=/npm-cache
RUN --mount=type=cache,id=airo-npm-global,target=/npm-cache,sharing=shared npm ci --no-fund --no-audit

# Move node_modules to root level for copy-on-write semantics
# This allows the /app bind mount to not require a 549MB volume copy on startup
# Node.js module resolution will find packages at /node_modules via directory traversal
RUN mv /app/node_modules /node_modules

# Pre-compute .npm-install-hash so startup doesn't trigger unnecessary npm install
# Stored in /node_modules (not /app) so it survives the /app bind mount
# nomad_setup.sh checks this location as fallback when /app/.npm-install-hash is missing
RUN cat package.json package-lock.json 2>/dev/null | md5sum | cut -d' ' -f1 > /node_modules/.npm-install-hash

# =================================================================
# Stage 2: Runtime Image (FAST - rebuilds on code changes)
# =================================================================
# CRITICAL: Must use the same base image as deps stage (node:22-alpine)
# to ensure platform-specific native binaries in node_modules are compatible
FROM node:22-alpine

# Accept build arguments for dynamic UID/GID mapping
ARG HOST_UID=790
ARG HOST_GID=790

# Install runtime dependencies only (including rsync for template syncing in nomad_setup.sh)
RUN apk add --no-cache curl git ca-certificates tzdata bash jq yq ripgrep rsync

# Create the group and user with dynamic UID/GID
# This allows the container user to match the host user for proper file permissions
# Validate and adjust GID if it's outside Alpine's supported range (0-256000)
RUN CONTAINER_GID=${HOST_GID}; \
    if [ ${HOST_GID} -gt 256000 ]; then \
        echo "Host GID ${HOST_GID} exceeds Alpine limit, using fallback GID 1000"; \
        CONTAINER_GID=1000; \
    fi; \
    if getent group $CONTAINER_GID >/dev/null 2>&1; then \
        echo "GID $CONTAINER_GID is already in use, reassigning to GID 9999"; \
        sed -i "/^[^:]*:[^:]*:$CONTAINER_GID:/s/:$CONTAINER_GID:/:9999:/" /etc/group; \
    fi; \
    addgroup -g $CONTAINER_GID agent

# Validate and adjust UID if it's outside Alpine's supported range
RUN CONTAINER_UID=${HOST_UID}; \
    if [ ${HOST_UID} -gt 256000 ]; then \
        echo "Host UID ${HOST_UID} exceeds Alpine limit, using fallback UID 1000"; \
        CONTAINER_UID=1000; \
    fi; \
    if getent passwd $CONTAINER_UID >/dev/null 2>&1; then \
        echo "UID $CONTAINER_UID is already in use, reassigning to UID 9999"; \
        sed -i "/^[^:]*:[^:]*:$CONTAINER_UID:/s/:$CONTAINER_UID:/:9999:/" /etc/passwd; \
    fi; \
    adduser -D -G agent -u $CONTAINER_UID agent
RUN echo 'agent:agent' | chpasswd

# Set working directory
WORKDIR /app

# Copy gitleaks binary from preparer stage
COPY --chown=agent:agent --from=gitleaks-preparer /usr/local/bin/gitleaks /usr/local/bin/gitleaks

# Copy dev-supervisor binary from build stage (not pre-built image)
COPY --chown=agent:agent --from=dev-supervisor-builder /usr/local/bin/dev-supervisor /usr/local/bin/dev-supervisor
COPY --chown=agent:agent --from=dev-supervisor-builder /usr/local/bin/airo-sandbox /usr/local/bin/airo-sandbox

# Copy node_modules from deps stage to /node_modules (not /app/node_modules)
# This allows the /app bind mount to overlay the image without requiring a 549MB volume copy
# Node.js module resolution walks up the directory tree and finds packages at /node_modules
# CRITICAL: Both stages MUST use identical base images (node:22-alpine) to ensure
# platform-specific native binaries in node_modules are compatible between stages
# Note: /node_modules/.npm-install-hash is included - used by nomad_setup.sh
COPY --from=deps --chown=agent:agent /node_modules /node_modules

# Prepare npm cache directory with correct ownership for non-root installs
RUN mkdir -p /npm-cache && chown -R agent:agent /npm-cache

# Copy application code to /app-template (separate from /app for conditional startup)
# /app will be used as the bind mount point for customer code
# /app-template serves as the base template for first-start initialization
COPY --chown=agent:agent . /app-template

# Create management-scripts directory and copy infrastructure management utilities
# These are infrastructure scripts, not part of the customer app template
# Scripts are already marked executable in git, no chmod needed
RUN mkdir -p /management-scripts
COPY --from=container-scripts --chown=agent:agent preview/package.json /management-scripts/package.json
COPY --from=container-scripts --chown=agent:agent preview/package-lock.json /management-scripts/package-lock.json
COPY --from=container-scripts --chown=agent:agent preview/sync-package-additions.js /management-scripts/sync-package-additions.js
COPY --from=container-scripts --chown=agent:agent preview/sync-template-files.js /management-scripts/sync-template-files.js
COPY --from=container-scripts --chown=agent:agent preview/nomad_setup.sh /management-scripts/nomad_setup.sh

# Install management-scripts own dependencies (babel etc. for sync-template-files.js
# AST transforms). Decoupled from the app template's /node_modules so the scripts
# work regardless of Docker layer caching of the app deps stage.
# Uses npm ci for reproducible installs from the committed lockfile.
RUN cd /management-scripts && npm ci --omit=dev --no-fund --no-audit

# Copy healthcheck script (must be available before switching to non-root user)
# Copies from container-scripts build context (already executable)
COPY --from=container-scripts preview/dev-supervisor-healthcheck.sh /usr/local/bin/dev-supervisor-healthcheck.sh

# Create logs and supervisor socket directories (in /app for WORKDIR)
RUN mkdir -p /app/logs /tmp/supervisor

# Create /app directory for bind mount and ensure ownership
# /app-template contains the base template, /app is the working directory for customer code
RUN mkdir -p /app/dist \
    && chown -R agent:agent /app /app-template /tmp/supervisor

# Switch to the agent user so we are not running as root
USER agent

# Create clean npm environment for agent user
RUN mkdir -p /home/agent
RUN echo "registry=https://registry.npmjs.org/" > ~/.npmrc

# Expose the frontend port (will be overridden by PREFERRED_FRONTEND_PORT)
EXPOSE 3000

# Set development environment variables
ENV NODE_ENV=development
ENV RUNNING_IN_DOCKER=true
ENV DEV_SUPERVISOR_SOCKET_PATH=/tmp/supervisor/dev-supervisor.sock
ENV NPM_CONFIG_CACHE=/npm-cache
# Add node_modules/.bin to PATH so npm scripts can find binaries (vite, tsc, etc.)
# /app/node_modules/.bin first so local installs override base image binaries
ENV PATH="/app/node_modules/.bin:/node_modules/.bin:$PATH"

# Deployment-specific configuration (NOMAD_TASK_NAME, start-on-request, conditional startup,
# etc.) is set at runtime by docker-compose-generator.ts or Nomad job templates, not here.

# Health check using dev-supervisor API
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD /usr/local/bin/dev-supervisor-healthcheck.sh

# Use dev-supervisor with conditional startup
# Mode detection happens internally (checks .git/config existence)
# Setup script handles both first-start and restart paths
# Command can be overridden via .airo/config.json (runtime.dev.command)
ENTRYPOINT ["/usr/local/bin/dev-supervisor"]
CMD ["npm", "run", "dev"]
