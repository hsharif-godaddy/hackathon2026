# Development Dockerfile for V8 App Template (Vite + React + Hono)
FROM node:22-alpine

# Accept build arguments for dynamic UID/GID mapping
ARG HOST_UID=790
ARG HOST_GID=790

# Install curl for health checks, git for repository initialization, and dev-supervisor dependencies
RUN apk add --no-cache curl git ca-certificates tzdata

# Create the group and user with dynamic UID/GID
# This allows the container user to match the host user for proper file permissions
# First, check if HOST_GID is already in use and reassign the conflicting group
RUN if getent group ${HOST_GID} >/dev/null 2>&1; then \
    echo "GID ${HOST_GID} is already in use, reassigning to GID 9999"; \
    sed -i "/^[^:]*:[^:]*:${HOST_GID}:/s/:${HOST_GID}:/:9999:/" /etc/group; \
    fi

# Check if HOST_UID is already in use and reassign the conflicting user
RUN if getent passwd ${HOST_UID} >/dev/null 2>&1; then \
    echo "UID ${HOST_UID} is already in use, reassigning to UID 9999"; \
    sed -i "/^[^:]*:[^:]*:${HOST_UID}:/s/:${HOST_UID}:/:9999:/" /etc/passwd; \
    fi

# Now create our agent group and user with the required HOST_GID and HOST_UID
RUN addgroup -g ${HOST_GID} agent
RUN adduser -D -G agent -u ${HOST_UID} agent
RUN echo 'agent:agent' | chpasswd

# Set working directory
WORKDIR /app

# Copy dev-supervisor binary from pre-built image
COPY --chown=agent:agent --from=airo-dev-supervisor:latest /usr/local/bin/dev-supervisor /usr/local/bin/dev-supervisor

# Copy package files to check for pnpm-lock.yaml
COPY --chown=agent:agent package.json ./
COPY --chown=agent:agent pnpm-lock.yaml* ./

# Enable corepack and prepare pnpm as root if pnpm-lock.yaml exists
# Configure pnpm to use a shared store location accessible by both users
RUN if [ -f pnpm-lock.yaml ]; then \
    corepack enable && corepack prepare pnpm@latest --activate && \
    mkdir -p /shared/pnpm-store && \
    chown -R agent:agent /shared/pnpm-store && \
    chmod -R 775 /shared/pnpm-store && \
    pnpm config set store-dir /shared/pnpm-store --global; \
    fi

# Copy source code (node_modules excluded via .dockerignore)
COPY --chown=agent:agent . .

# Create logs and supervisor socket directories
RUN mkdir -p logs /tmp/supervisor
RUN chown -R agent:agent logs /tmp/supervisor

# Make sure the agent user owns the app directory initially
RUN chown -R agent:agent /app

# Switch to the agent user so we are not running as root
USER agent

# Create clean npm environment for agent user and configure pnpm store
RUN mkdir -p /home/agent
RUN echo "registry=https://registry.npmjs.org/" > ~/.npmrc
RUN if [ -f pnpm-lock.yaml ]; then \
    pnpm config set store-dir /shared/pnpm-store; \
    fi

# Install dependencies as the agent user
# Support both npm and pnpm (v3 templates may use pnpm)
RUN if [ -f pnpm-lock.yaml ]; then \
    pnpm install --registry=https://registry.npmjs.org/; \
    else \
    npm install --registry=https://registry.npmjs.org/ --no-fund --no-audit; \
    fi

# Expose the frontend port (will be overridden by PREFERRED_FRONTEND_PORT)
EXPOSE 3000

# Set development environment variables
ENV NODE_ENV=development
ENV VITE_HMR_HOST=0.0.0.0
ENV RUNNING_IN_DOCKER=true
ENV DEV_SUPERVISOR_SOCKET_PATH=/tmp/supervisor/dev-supervisor.sock

# Health check using dev-supervisor API
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl --unix-socket /tmp/supervisor/dev-supervisor.sock http://localhost/health || exit 1

# Use our dev-specific git setup script via dev-supervisor
ENTRYPOINT ["/usr/local/bin/dev-supervisor"]
CMD ["/app/dev_setup_and_serve.sh"]
