# Development Dockerfile for V8 App Template (Vite + React + Hono)
FROM node:22-alpine

# Install curl for health checks, gosu for user switching, and dev-supervisor dependencies
RUN apk add --no-cache curl ca-certificates tzdata gosu

# Create the group and user
# Using same GID/UID as main Dockerfile for consistency
# Create as regular user (not system user) so we can use su if needed
RUN addgroup -g 790 agent
RUN adduser -D -G agent -u 790 agent
RUN echo 'agent:agent' | chpasswd

# Set working directory
WORKDIR /app

# Copy dev-supervisor binary from pre-built image
COPY --from=airo-dev-supervisor:latest /usr/local/bin/dev-supervisor /usr/local/bin/dev-supervisor

# Copy dev-specific entrypoint script
COPY docker-entrypoint-dev.sh /usr/local/bin/docker-entrypoint-dev.sh
RUN chmod +x /usr/local/bin/docker-entrypoint-dev.sh

# Copy package files to check for pnpm-lock.yaml
COPY --chown=agent:agent package.json ./
COPY --chown=agent:agent pnpm-lock.yaml* ./

# Enable corepack and prepare pnpm as root if pnpm-lock.yaml exists
# Configure pnpm to use a shared store location accessible by both users
RUN if [ -f pnpm-lock.yaml ]; then \
    corepack enable && corepack prepare pnpm@latest --activate && \
    mkdir -p /shared/pnpm-store && \
    chown -R agent:agent /shared/pnpm-store && \
    chmod -R 775 /shared/pnpm-store && \
    pnpm config set store-dir /shared/pnpm-store --global; \
    fi

# Copy source code (node_modules excluded via .dockerignore)
COPY --chown=agent:agent . .

# Create logs and supervisor socket directories 
# The entrypoint script will fix permissions for bind mounts at runtime
RUN mkdir -p logs /tmp/supervisor

# Make sure the agent user owns the app directory initially
RUN chown -R agent:agent /app

# Note: We don't switch users here - the entrypoint script handles this

# Create clean npm environment for agent user and configure pnpm store
RUN mkdir -p /home/agent && chown agent:agent /home/agent
RUN su agent -c 'echo "registry=https://registry.npmjs.org/" > ~/.npmrc'
RUN if [ -f pnpm-lock.yaml ]; then \
    su agent -c 'pnpm config set store-dir /shared/pnpm-store'; \
    fi

# Install dependencies as the agent user
# Support both npm and pnpm (v3 templates may use pnpm)
RUN if [ -f pnpm-lock.yaml ]; then \
    su agent -c 'pnpm install --registry=https://registry.npmjs.org/'; \
    else \
    su agent -c 'npm install --registry=https://registry.npmjs.org/ --no-fund --no-audit'; \
    fi

# Expose the frontend port (will be overridden by PREFERRED_FRONTEND_PORT)
EXPOSE 3000

# Set development environment variables
ENV NODE_ENV=development
ENV VITE_HMR_HOST=0.0.0.0
ENV RUNNING_IN_DOCKER=true
ENV DEV_SUPERVISOR_SOCKET_PATH=/tmp/supervisor/dev-supervisor.sock

# Health check using dev-supervisor API
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl --unix-socket /tmp/supervisor/dev-supervisor.sock http://localhost/health || exit 1

# Use our dev-specific entrypoint script to fix permissions then run dev-supervisor
ENTRYPOINT ["/usr/local/bin/docker-entrypoint-dev.sh"]
CMD ["/usr/local/bin/dev-supervisor", "npm", "run", "dev"]
