# Development Dockerfile for Next.js App Template v2 (with Turbopack)
FROM node:22-alpine

# Install curl for health checks and dev-supervisor dependencies
RUN apk add --no-cache curl ca-certificates tzdata

# Set working directory
WORKDIR /app

# Copy dev-supervisor binary from pre-built image
COPY --from=airo-dev-supervisor:latest /usr/local/bin/dev-supervisor /usr/local/bin/dev-supervisor

# Create clean npm environment
RUN echo "registry=https://registry.npmjs.org/" > /root/.npmrc

# Copy package.json and install dependencies
COPY package.json ./
RUN npm install --registry=https://registry.npmjs.org/ --no-fund --no-audit

# Copy source code (node_modules excluded via .dockerignore)
COPY . .

# Create logs directory and supervisor socket directory
RUN mkdir -p logs /tmp/supervisor

# Expose the port (will be overridden by environment)
EXPOSE 3000

# Set development environment
ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1
ENV DEV_SUPERVISOR_SOCKET_PATH=/tmp/supervisor/dev-supervisor.sock

# Health check using dev-supervisor API
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl --unix-socket /tmp/supervisor/dev-supervisor.sock http://localhost/health || exit 1

# Use dev-supervisor as PID 1 to manage the development process
ENTRYPOINT ["/usr/local/bin/dev-supervisor"]
CMD ["npm", "run", "dev", "--", "--hostname", "0.0.0.0"]
