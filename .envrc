# Use mise for node version management if available, otherwise fall back to nvm
# mise reads .nvmrc natively and is significantly faster than sourcing nvm.sh
use_mise=false
if command -v mise > /dev/null 2>&1; then
  # Install any missing tool versions (reads .nvmrc, .tool-versions, mise.toml)
  mise install --quiet 2>/dev/null
  # Verify mise can now provide node for this project
  if mise which node > /dev/null 2>&1; then
    eval "$(mise env)"
    use_mise=true
  else
    echo "mise is installed but Node is not configured in mise for this project"
    echo "Falling back to nvm..."
  fi
fi

if [ "$use_mise" = false ]; then
  # Fall back to nvm
  # See: https://github.com/direnv/direnv/issues/319
  if [ -z "${NVM_DIR:-}" ]; then
    echo "NVM_DIR environment variable not found"
    echo "Please ensure mise or nvm is installed"
    echo "mise install: https://mise.jdx.dev"
    echo "nvm install: https://github.com/nvm-sh/nvm#installing-and-updating"
    exit 1
  fi

  if [ ! -s "${NVM_DIR}/nvm.sh" ]; then
    echo "nvm.sh not found in NVM_DIR: ${NVM_DIR}"
    echo "Is your nvm installation working correctly?"
    exit 1
  fi

  . "${NVM_DIR}/nvm.sh"

  # This automatically does an "nvm use" afterwards
  nvm install
fi

# Set up node layout (adds node_modules/.bin to PATH, sets NODE_PATH)
# Must run after mise/nvm so node is available
layout node

# Enable Corepack to manage pnpm version (enforces version from package.json)
if ! corepack --version &>/dev/null 2>&1; then
  echo "⚠️  Corepack not available - consider upgrading to Node.js 16.9+ for built-in Corepack"
  echo "Installing pnpm globally as fallback..."
  npm install -g pnpm@10.17.0
else
  echo "Enabling Corepack for consistent pnpm version management..."
  corepack enable
  # Corepack will automatically use pnpm 10.17.0 from package.json packageManager field
fi

# Workspace protection: prevent pnpm install in subdirectories
export WORKSPACE_ROOT="$(pwd)"

# Non-workspace directories that should auto-add --ignore-workspace
export NON_WORKSPACE_DIRS="app-templates/v8"

# Find the real pnpm binary (not our wrapper)
REAL_PNPM=$(PATH="${PATH#*.direnv/bin:}" command -v pnpm)
export REAL_PNPM

# Create pnpm wrapper script
mkdir -p .direnv/bin
cat >.direnv/bin/pnpm <<'EOF'
#!/bin/bash
cmd="$1"
current_dir="$(pwd)"
relative_path="${current_dir#$WORKSPACE_ROOT/}"

# Check if we're in a non-workspace directory
is_non_workspace=false
for dir in $NON_WORKSPACE_DIRS; do
  if [[ "$relative_path" == "$dir"* ]]; then
    is_non_workspace=true
    break
  fi
done

# Handle install/i commands
if [ "$cmd" = "install" ] || [ "$cmd" = "i" ]; then
  if [ "$is_non_workspace" = true ]; then
    # In non-workspace dir: auto-add --ignore-workspace
    echo "Auto-adding --ignore-workspace for $relative_path" >&2
    shift  # Remove 'install' or 'i' from arguments
    exec "$REAL_PNPM" "$cmd" --ignore-workspace "$@"
  elif [ "$current_dir" != "$WORKSPACE_ROOT" ]; then
    # In workspace subdir: block with error
    echo "Error: pnpm install must be run from the workspace root" >&2
    echo "Current directory: $current_dir" >&2
    echo "Workspace root: $WORKSPACE_ROOT" >&2
    echo "" >&2
    echo "Please run: cd $WORKSPACE_ROOT && pnpm install" >&2
    exit 1
  fi
fi

# For all other commands, allow execution anywhere
exec "$REAL_PNPM" "$@"
EOF
chmod +x .direnv/bin/pnpm

# Add wrapper to PATH
PATH_add .direnv/bin
