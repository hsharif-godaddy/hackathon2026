# Load untracked local overrides if present (e.g. DEV_SUPERVISOR_SANDBOX_ENABLED
# set by `pnpm run sandbox:on`). Must come before version manager setup so
# locally-set vars are visible to the rest of this file.
source_env_if_exists .envrc.local

# Load Node.js via the first available version manager (mise > fnm > asdf > nvm)
setup_mise() {
  mise settings add idiomatic_version_file_enable_tools node 2>/dev/null
  mise install --quiet
  if mise which node > /dev/null 2>&1; then
    # direnv uses bash for evals
    eval "$(mise env -s bash)"
    return 0
  fi
  echo "mise is installed but Node is not configured for this project"
  return 1
}

setup_fnm() {
  eval "$(fnm env)"
  fnm install
  fnm use
}

setup_asdf() {
  . "$(brew --prefix asdf 2>/dev/null || echo "${ASDF_DIR:-$HOME/.asdf}")/asdf.sh" 2>/dev/null || return 1
  asdf install nodejs 2>/dev/null
  asdf shell nodejs "$(cat .nvmrc 2>/dev/null)" 2>/dev/null
}

setup_nvm() {
  # See: https://github.com/direnv/direnv/issues/319
  [ -n "${NVM_DIR:-}" ] && [ -s "${NVM_DIR}/nvm.sh" ] || return 1
  . "${NVM_DIR}/nvm.sh"
  nvm install  # also runs "nvm use"
}

node_activated=false
for manager in mise fnm asdf nvm; do
  if [ "$manager" = "nvm" ]; then
    # nvm is a shell function, not a binary — check NVM_DIR instead
    [ -n "${NVM_DIR:-}" ] && [ -s "${NVM_DIR}/nvm.sh" ] || continue
  else
    command -v "$manager" > /dev/null 2>&1 || continue
  fi

  if "setup_$manager"; then
    node_activated=true
    break
  fi
done

if [ "$node_activated" = false ]; then
  echo "No Node.js version manager found"
  echo "Please install one of: mise, fnm, asdf, or nvm"
  echo "  mise: https://mise.jdx.dev"
  echo "  fnm:  https://github.com/Schniz/fnm#installation"
  echo "  asdf: https://asdf-vm.com/guide/getting-started.html"
  echo "  nvm:  https://github.com/nvm-sh/nvm#installing-and-updating"
  exit 1
fi

# Set up node layout (adds node_modules/.bin to PATH, sets NODE_PATH)
# Must run after mise/nvm so node is available
layout node

# Enable Corepack to manage pnpm version (enforces version from package.json)
if ! corepack --version &>/dev/null 2>&1; then
  echo "⚠️  Corepack not available - consider upgrading to Node.js 16.9+ for built-in Corepack"
  echo "Installing pnpm globally as fallback..."
  PNPM_VERSION=$(node -p "require('./package.json').packageManager.match(/^pnpm@(.+?)(\+|$)/)[1]")
  npm install -g "pnpm@${PNPM_VERSION}"
else
  echo "Enabling Corepack for consistent pnpm version management..."
  corepack enable
  # Corepack will automatically use the pnpm version from package.json packageManager field
fi

# Workspace protection: prevent pnpm install in subdirectories
export WORKSPACE_ROOT="$(pwd)"

# Non-workspace directories that should auto-add --ignore-workspace
export NON_WORKSPACE_DIRS="app-templates/v8"

# Find the real pnpm binary (not our wrapper)
REAL_PNPM=$(PATH="${PATH#*.direnv/bin:}" command -v pnpm)
export REAL_PNPM

# Prepend .direnv/bin to PATH so the committed pnpm wrapper (.direnv/bin/pnpm)
# intercepts pnpm commands for workspace protection.
PATH_add .direnv/bin

if [[ -t 1 ]]; then
  echo ""
  echo "======================================================================"
  echo " DEV ENVIRONMENT QUICK START"
  echo "======================================================================"
  echo ""
  echo " First-time setup:"
  echo "   pnpm run dev               (preflight checks generate .env files, configure AWS, etc.)"
  echo ""
  echo " Before starting (or let preflight handle it automatically):"
  echo "   - Docker must be running   (preflight starts MySQL container)"
  echo "   - AWS SSO login:           preflight runs 'aws sso login' if session is expired"
  echo "   - /etc/hosts must contain: 127.0.0.1  local.gasket.dev-godaddy.com  (preflight checks this)"
  echo ""
  echo " Start all services (recommended):"
  echo "   pnpm run dev                              # TUI with all services"
  echo ""
  echo " Or start individually:"
  echo "   cd agents && pnpm run dev                 # Agents (port 4000)"
  echo "   cd app && pnpm run dev                    # App / BFF (HTTPS 8443)"
  echo "   pnpm run dev:control-plane                # Local Control Plane (4100)"
  echo ""
  echo " Access:"
  echo "   App:    https://local.gasket.dev-godaddy.com:8443"
  echo "   Agents: https://local.gasket.dev-godaddy.com:4000"
  echo ""
  echo "======================================================================"
  echo ""
fi
