# Debug Console - Environment Configuration Example
# Copy this file to .env.local and configure the values for your environment

# =============================================================================
# Server Configuration
# =============================================================================

# Node environment
# Options: development, production, test
NODE_ENV=development

# Server port
# Local dev: `pnpm dev` sets PORT=3443 in the npm script; uncomment to override.
# Deployed containers: PORT=8443 is set by Dockerfile's runtime ENV.
# server.ts falls back to 443 (privileged, requires sudo) only when PORT is unset.
# PORT=3443

# SSL Certificate paths
# Server REQUIRES HTTPS in dev/prod (SSO won't work over HTTP) and will exit 1
# if the cert/key cannot be loaded. See debug-console/README.md for self-signed
# cert generation instructions. Override paths only when not using ./certs/.
# SERVER_KEY_PATH=./certs/server.key
# SERVER_CERT_PATH=./certs/server.crt

# =============================================================================
# Authentication Configuration
# =============================================================================

# SSO Configuration
#
# No env vars to set — sso-host.ts derives the SSO host from the request
# FQDN's zone. `SSO_LOGIN_URL` and `NEXT_PUBLIC_SSO_LOGIN_URL` are no longer
# honored; remove them from `.env.local` if leftover from a prior setup.

# =============================================================================
# Elasticsearch Configuration
# =============================================================================

# Airo Builder Elasticsearch endpoint
# Used for: APM traces (traces-apm* indices), the airo-app log source, and as
# the analytics scheduler write target (es-client.ts). Must be the ES REST API
# host (.es.), NOT the Kibana UI host (.kb.).
# Example: https://airobuilde-non-prod-usw2.es.us-west-2.aws.found.io:9243
AIRO_BUILDER_ES_ENDPOINT=https://airobuilde-non-prod-usw2.es.us-west-2.aws.found.io:9243

# Airo Builder Elasticsearch API key (for APM traces)
# Get from AWS Secrets Manager or your Elasticsearch deployment
AIRO_BUILDER_ES_API_KEY=your-airo-builder-elasticsearch-api-key-here

# Control Plane Elasticsearch endpoint (for management/control plane logs)
# Example: https://pioneermgt-prod-usw2.es.us-west-2.aws.found.io:9243
CONTROL_PLANE_ES_ENDPOINT=

# Control Plane Elasticsearch API key
CONTROL_PLANE_ES_API_KEY=

# PDNA Elasticsearch endpoint (for PDNA logs)
# Example: https://mwpdata-prod-usw2.es.us-west-2.aws.found.io:9243
PDNA_ES_ENDPOINT=

# PDNA Elasticsearch API key
PDNA_ES_API_KEY=

# Optional: Custom prefix for analytics indices (default: airo_analytics_)
# ES_INDEX_PREFIX=airo_analytics_

# =============================================================================
# Investigate (AWS Lambda runner for the investigate-feedback skill)
# =============================================================================
#
# The /investigate page in debug-console triggers an async Lambda that runs the
# investigate-feedback skill via Claude CLI. State + reports live in S3. Both
# Lambda + bucket are provisioned by cdk/lib/investigator-stack.ts
# (stack name: AiroInvestigatorStack).
#
# In local dev these usually point at the dev-airobuilde account resources.

# S3 bucket for investigation state (default: airo-investigations-dev)
# INVESTIGATE_BUCKET=airo-investigations-dev

# Lambda function name (default: airo-investigator-dev)
# INVESTIGATE_LAMBDA_FN=airo-investigator-dev

# Environment name for index selection
# Options: dev, test, prod
# Determines which Elasticsearch indices to use (e.g., airo-agents-dev vs airo-agents-prod)
ENVIRONMENT_NAME=dev

# =============================================================================
# Loki Configuration (REQUIRED)
# =============================================================================
#
# Loki is the log backend for airo-agents, airo-preview, and airo-publish
# sources as well as the analytics scheduler. If LOKI_ENDPOINT is not set the
# Logs tab and analytics pipeline will fail fast so misconfigured deploys are
# caught early. Elasticsearch is only used for UI client (airo-app) and
# control_plane sources.

# Loki endpoint URL (use Grafana proxy for access)
# Grafana proxy format: https://grafana.monitoring.gd3p.tools/api/datasources/proxy/uid/{datasource_uid}
# Example: https://grafana.monitoring.gd3p.tools/api/datasources/proxy/uid/ff18mpwxpc7wgd
# Default Grafana Loki datasource UID: ff18mpwxpc7wgd
LOKI_ENDPOINT=

# Loki API key for authentication
# Get from Grafana: https://grafana.monitoring.gd3p.tools
# Create a service account token with Viewer role
LOKI_API_KEY=

# Client-side environment label — used by the Logs tab Query Inspector to
# render the `env="..."` label in the LogQL preview. Defaults to "dev"
# when unset.
NEXT_PUBLIC_ENVIRONMENT_NAME=dev

# =============================================================================
# Langfuse Configuration
# =============================================================================

# Langfuse "Native" (raw AI-SDK traces). debug-console no longer queries this
# instance server-side — it reads conversations/traces and the support bundle
# from Langfuse EB below. The Native instance is now only the target of the
# per-trace "Native ↗" deep link, so just the client-side NEXT_PUBLIC_* pair is
# needed (no server keys). Trace IDs are shared across both instances.
#
# Apps Analytics (scores, costs, metrics) also uses the EB_LANGFUSE_* keys
# (same as /api/eb-langfuse, /api/langfuse-analytics).

# Client-side Native Langfuse UI base URL + project ID (inlined into the bundle
# by Next.js). These power the per-trace "Native ↗" deep link in the browser.
NEXT_PUBLIC_LANGFUSE_BASE_URL=
NEXT_PUBLIC_LANGFUSE_PROJECT_ID=

EB_LANGFUSE_BASE_URL=https://agentobser-langfuse.int.godaddy.com
EB_LANGFUSE_PROJECT_ID=cm...
EB_LANGFUSE_PUBLIC_KEY=pk-lf-...
EB_LANGFUSE_SECRET_KEY=sk-lf-...

# Client-side EB Langfuse UI base URL + project ID (inlined into the bundle by Next.js).
# These power the "Open in Langfuse EB" deep links rendered in the browser.
NEXT_PUBLIC_EB_LANGFUSE_BASE_URL=
NEXT_PUBLIC_EB_LANGFUSE_PROJECT_ID=

# =============================================================================
# GitHub releases (RISQ page + GET /api/releases)
# =============================================================================
# Repo is fixed to https://github.com/gdcorp-partners/airo-app-builder (see /api/releases).
# PAT needs repo Contents (releases) and Actions read (GET /api/e2e-runs workflow runs). Server-side only.
GITHUB_TOKEN=

# =============================================================================
# FullStory (Hosted MCP server used as the `fullstory` investigate evidence source)
# =============================================================================
# Server-side only. Debug-console POSTs JSON-RPC to FULLSTORY_MCP_URL with
# `Authorization: Basic $FULLSTORY_API_KEY`. The API key must belong to an
# account in the FullStory MCP beta program and carry the permissions needed
# for build_segment + get_sessions + get_session_events.
#
# Generate an Admin API key: FullStory UI → Settings → API Keys.
FULLSTORY_API_KEY=
# Optional override; defaults to https://api.fullstory.com/mcp/fullstory.
FULLSTORY_MCP_URL=

# =============================================================================
# ClickHouse (C1 Analytics on Apps Analytics page — analytics.c1_events)
# =============================================================================
# Host may be https://<host>:8443 or http://<host>:8123 (scheme optional; https assumed).
CLICKHOUSE_HOST=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=

# =============================================================================
# S3 — customer feedback (Apps Analytics → Customer feedback section)
# =============================================================================
# Bucket name from secrets (e.g. airo-builder-feedback-prod). Optional prefix
# defaults to airo_builder_feedback_cln/ (Hive-style year=/month=/day=/… under prefix).
# List reads objects whose keys end in .json / .jsonl / .ndjson or contain hour= (deeper segments OK).
FEEDBACK_S3_BUCKET=
# FEEDBACK_S3_PREFIX=airo_builder_feedback_cln/


# =============================================================================
# Upstream GoDaddy Service Hosts (server-side proxies)
# =============================================================================

# Base URL for the GoDaddy Shopper API (used by /api/shopper/[shopperId]).
# Default: https://shopper.api.int.godaddy.com
SHOPPER_BASE_URL=

# Base URL for the Care Conversation State Service (used by /api/care/*).
# Default: https://conversation-state-service.care.godaddy.com
CARE_BASE_URL=

# =============================================================================
# Mgmt Airo Control Plane Configuration
# =============================================================================

# Base URL for the mgmt airo control plane
# Test: https://mgmt.nstk.net
# Prod: https://mgmt.woosaas.godaddy.com
MGMT_AIRO_BASE_URL=https://mgmt.nstk.net

# Inline client certificate and key for authenticating to the mgmt control plane
# Test cert CN:  console.airo-builder.test.authclient.int.godaddy.com
# Prod cert CN:  console.airo-builder.authclient.int.godaddy.com
CONSOLE_CERT="<cert_content>"
CONSOLE_KEY="<key_content>"

# =============================================================================
# BMS — Budget Management Service
# =============================================================================
#
# The /api/bms/spend and /api/bms/spend/daily routes (used by the App Detail
# panel's Subscription Details section for BMS-migrated subscriptions) call
# BMS at this URL. Auth is an S2S IAM JWT minted via @airo/ai-lib's
# `getS2SToken` (gd-auth-client `IamTokenClient`) — no extra credential to
# configure here, just AWS creds via the standard provider chain.
#
# When unset, the URL is derived from the request's Host header as
# `https://budget-service.api.int.{rootDomain}` (e.g. `…test-godaddy.com`).
# That works when you access debug-console via a hostname whose root domain
# matches the BMS env you want to call. Set BUDGET_SERVICE_URL explicitly
# when those don't line up — e.g. accessing the local dev server via a
# `*.godaddy.com` hostname (root → prod) but wanting to call test BMS.
#
# Locally, the IAM role minted from `AWS_PROFILE=airobuild-dev-private-sso`
# is on test BMS's `AUTH_ALLOWED_ROLES` allowlist; other personal SSO roles
# return 403 IAM_ROLE_DENIED. The minted JWT must come from the SSO host
# matching BMS's env (test BMS → sso.test-godaddy.com); set SSO_HOST below
# (or NODE_ENV=test, but Next.js dev mode pins NODE_ENV=development) to
# override the dev default.
#
# Test:  https://budget-service.api.int.test-godaddy.com
# Prod:  https://budget-service.api.int.godaddy.com
# BUDGET_SERVICE_URL=https://budget-service.api.int.test-godaddy.com

# Override the SSO host used for S2S token minting independent of NODE_ENV.
# Required when calling test BMS from a Next.js dev server (NODE_ENV=development
# defaults to sso.dev-godaddy.com, and BMS rejects dev-issued JWTs with 401).
# SSO_HOST=sso.test-godaddy.com

# =============================================================================
# Agents JWT Signing (for /agent-conversations debug page)
# =============================================================================
# Used by the read-only agent-conversations debug page to mint short-lived
# JWTs that the customer-app agents service accepts.
#
# Preferred: read the same secret as app/ from AWS Secrets Manager. Requires
# the debug-console runtime to have GetSecretValue on the secret. When set,
# Secrets Manager fetch failures fail closed (no silent fallback) unless
# AGENT_JWT_ALLOW_STATIC_FALLBACK=true is also set.
# JWT_SECRETS_NAME=dev-airo-jwt-keys
# AWS_REGION=us-west-2
#
# Fallback when JWT_SECRETS_NAME is unset, or when JWT_SECRETS_NAME is set
# AND AGENT_JWT_ALLOW_STATIC_FALLBACK=true (to support local dev without AWS
# credentials). Copy the active key from the Secrets Manager secret. Must
# match the kid published by app/'s JWKS so the agents service can resolve
# the public key during verification.
# AGENT_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# AGENT_JWT_KEY_ID=<keyId>
# AGENT_JWT_ALLOW_STATIC_FALLBACK=true

# =============================================================================
# Build/Deployment Configuration
# =============================================================================

# Katana artifact version (optional)
# Used for version tracking in health checks
# KATANA_ARTIFACT_VERSION=1.0.0

# =============================================================================
# Usage Instructions
# =============================================================================

# 1. Copy this file to .env.local:
#    cp env.example .env.local
#
# 2. Configure Loki (required for airo-agents, airo-preview, airo-publish and
#    the analytics scheduler):
#    Set LOKI_ENDPOINT and LOKI_API_KEY
#
# 3. Configure Elasticsearch for airo-app and control_plane sources:
#    Set AIRO_BUILDER_ES_ENDPOINT / AIRO_BUILDER_ES_API_KEY (also used as the
#    analytics write target) and CONTROL_PLANE_ES_ENDPOINT / CONTROL_PLANE_ES_API_KEY
#
# 4. Set ENVIRONMENT_NAME to match your environment (dev/test/prod)
#    This determines which indices and Loki `env` label are used
#
# Note: Environment variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Never put sensitive secrets in NEXT_PUBLIC_ variables.

# =============================================================================
# SupportPlane — AI Chat (GoCaaS / OpenAI-compatible proxy)
# =============================================================================
# Powers the /supportplane AI Chat tab via GoDaddy's internal AI proxy (GoCaaS).
# Uses OpenAI-compatible /v1/chat/completions format.
#
# OPENAI_BASE_URL selects the GoCaaS environment:
#   prod → https://caas-gocode.caas.prod.onkatana.net
#   test → https://caas-gocode-test.caas-test.prod.onkatana.net
#   dev  → https://caas-gocode-dev.caas-dev.prod.onkatana.net
# When OPENAI_BASE_URL is unset the route auto-selects by NODE_ENV.
#
# These match the agents/ environment variable names for consistency.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://caas-gocode.caas.prod.onkatana.net
# GOCAAS_MODEL=claude-opus-4-6

# =============================================================================
# SupportPlane — Jira (CIEC + AABSP ticket search)
# =============================================================================
# Used by the `search_jira_tickets` and `get_jira_ticket` AI tools.
# Searches across both CIEC (incidents/escalations) and AABSP (customer feedback).
#
# Option A — NSA service account OAuth 2.0 (same flow as fanout-lambda, PREFERRED):
#   POST clientId+clientSecret to auth.atlassian.com → 60-min Bearer.
#   Hits api.atlassian.com/ex/jira/<cloudId>/rest/api/3/...
#   Scopes required: read:jira-work
#   Obtain cloud ID: https://godaddy-corp.atlassian.net/_edge/tenant_info
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_CLOUD_ID=
# JIRA_OAUTH_TOKEN_URL=https://auth.atlassian.com/oauth/token

# Option B — Personal API token (Basic Auth fallback, used when JIRA_CLOUD_ID is unset):
#   Generate at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://godaddy-corp.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# =============================================================================
# SupportPlane — ServiceNow (on-call lookup)
# =============================================================================
# Used by the `get_oncall` AI tool.
# Can use personal GoDaddy credentials while waiting for a service account.
SERVICENOW_INSTANCE=godaddy.service-now.com
SERVICENOW_USER=
SERVICENOW_PASSWORD=
# Roster group ID for the Airo Builder on-call rota
SERVICENOW_GROUP_ID=

# =============================================================================
# SupportPlane — SharePoint (L1 transcript ingestion)
# =============================================================================
# Powers the /supportplane Transcripts tab via Microsoft Graph API.
# Two authentication strategies are supported:
#
# Strategy A — App client_credentials (PREFERRED for production):
#   Register an Azure AD app with Sites.Read.All (application permission).
#   Grant admin consent, then fill SP_TENANT_ID + SP_CLIENT_ID + SP_CLIENT_SECRET.
SP_TENANT_ID=
SP_CLIENT_ID=
SP_CLIENT_SECRET=
#
# Strategy B — ROPC username/password (personal credentials, interim use):
#   Set SP_TENANT_ID + SP_CLIENT_ID + SP_USERNAME + SP_PASSWORD.
#   SP_CLIENT_ID must allow public-client / ROPC flow in Azure AD.
#   SP_CLIENT_SECRET must be left UNSET for this path to activate.
#   Use your own GoDaddy credentials while waiting for a service account.
# SP_USERNAME=
# SP_PASSWORD=
#
# Site configuration (defaults shown — only change if topology differs):
# SP_SITE_HOSTNAME=secureservernet.sharepoint.com
# SP_SITE_NAME=CareServices
# SP_TRANSCRIPTS_PATH=Shared Documents/Contact Drivers/Daily Transcripts
#
# S3 landing zone for uploaded xlsx + SQLite backups (FeedbackL1TranscriptStack, us-west-2)
# L1_TRANSCRIPTS_S3_BUCKET=airo-builder-l1-transcripts-dev
# L1_TRANSCRIPTS_S3_REGION=us-west-2
# L1_TRANSCRIPTS_DB_PATH=./data/l1_transcripts.db
