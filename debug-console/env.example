# Debug Console - Environment Configuration Example
# Copy this file to .env.local and configure the values for your environment

# =============================================================================
# Server Configuration
# =============================================================================

# Node environment
# Options: development, production, test
NODE_ENV=development

# Server port
# Default: 8443
PORT=8443

# SSL Certificate paths (optional - falls back to HTTP if not found)
# SERVER_KEY_PATH=./certs/server.key
# SERVER_CERT_PATH=./certs/server.crt

# =============================================================================
# Authentication Configuration
# =============================================================================

# Bypass authentication for local development
# Set to 'true' or '1' to bypass auth in local environment
# Default: Automatically bypassed when NODE_ENV=development
BYPASS_AUTH=true

# Client-side auth bypass (for browser)
# Set to 'true' to bypass auth on the client side
NEXT_PUBLIC_BYPASS_AUTH=true

# SSO Configuration
# SSO Login URL - Default: https://sso.test-godaddy.com/login
SSO_LOGIN_URL=https://sso.test-godaddy.com/login

# Client-side SSO URL (for browser redirects)
NEXT_PUBLIC_SSO_LOGIN_URL=https://sso.test-godaddy.com/login

# =============================================================================
# Elasticsearch Configuration
# =============================================================================

# Elasticsearch endpoint for log sources
# Default: https://pioneerc1-non-prod-usw2.es.us-west-2.aws.found.io:9243
PIONEER_ES_ENDPOINT=https://pioneerc1-non-prod-usw2.es.us-west-2.aws.found.io:9243

# Elasticsearch API key for authentication
# Get from AWS Secrets Manager or your Elasticsearch deployment
PIONEER_ES_API_KEY=your-elasticsearch-api-key-here

# Airo Builder Elasticsearch endpoint (for APM traces)
# Used for querying APM traces (traces-apm* indices)
# Example: https://airobuilde-non-prod-usw2.kb.us-west-2.aws.found.io:9243
AIRO_BUILDER_ES_ENDPOINT=https://airobuilde-non-prod-usw2.kb.us-west-2.aws.found.io:9243

# Airo Builder Elasticsearch API key (for APM traces)
# Get from AWS Secrets Manager or your Elasticsearch deployment
AIRO_BUILDER_ES_API_KEY=your-airo-builder-elasticsearch-api-key-here

# Proxy service Elasticsearch endpoint (optional)
# Falls back to PIONEER_ES_ENDPOINT if not set
# PROXY_ES_ENDPOINT=https://pioneerc1-non-prod-usw2.es.us-west-2.aws.found.io:9243

# Proxy service Elasticsearch API key (optional)
# Falls back to PIONEER_ES_API_KEY if not set
# PROXY_ES_API_KEY=your-proxy-elasticsearch-api-key-here

# Environment name for index selection
# Options: dev, test, prod
# Determines which Elasticsearch indices to use (e.g., airo-agents-dev vs airo-agents-prod)
ENVIRONMENT_NAME=dev

# =============================================================================
# Langfuse Configuration
# =============================================================================

# Langfuse API endpoint
# Default: https://agentobser-agent-obs-langfuse-test.agentobser-test.prod.onkatana.net
LANGFUSE_BASE_URL=

# Langfuse API keys
# Get from Langfuse project settings
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Langfuse Project ID (for generating direct links to traces/users)
# Get from Langfuse URL: /project/{PROJECT_ID}/...
LANGFUSE_PROJECT_ID=

# =============================================================================
# Build/Deployment Configuration
# =============================================================================

# Katana artifact version (optional)
# Used for version tracking in health checks
# KATANA_ARTIFACT_VERSION=1.0.0

# =============================================================================
# Usage Instructions
# =============================================================================

# 1. Copy this file to .env.local:
#    cp env.example .env.local
#
# 2. Configure your Elasticsearch credentials:
#    Set PIONEER_ES_ENDPOINT and PIONEER_ES_API_KEY
#
# 3. For local development, authentication is automatically bypassed
#    when NODE_ENV=development or BYPASS_AUTH=true
#
# 4. Set ENVIRONMENT_NAME to match your environment (dev/test/prod)
#    This determines which Elasticsearch indices are used
#
# Note: Environment variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Never put sensitive secrets in NEXT_PUBLIC_ variables.
