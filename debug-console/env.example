# Debug Console - Environment Configuration Example
# Copy this file to .env.local and configure the values for your environment

# =============================================================================
# Server Configuration
# =============================================================================

# Node environment
# Options: development, production, test
NODE_ENV=development

# Server port
# Default: 8443
PORT=8443

# SSL Certificate paths (optional - falls back to HTTP if not found)
# SERVER_KEY_PATH=./certs/server.key
# SERVER_CERT_PATH=./certs/server.crt

# =============================================================================
# Authentication Configuration
# =============================================================================

# Bypass authentication for local development
# Set to 'true' or '1' to bypass auth in local environment
# Default: Automatically bypassed when NODE_ENV=development
BYPASS_AUTH=true

# Client-side auth bypass (for browser)
# Set to 'true' to bypass auth on the client side
NEXT_PUBLIC_BYPASS_AUTH=true

# SSO Configuration
# SSO Login URL - Default: https://sso.test-godaddy.com/login
SSO_LOGIN_URL=https://sso.test-godaddy.com/login

# Client-side SSO URL (for browser redirects)
NEXT_PUBLIC_SSO_LOGIN_URL=https://sso.test-godaddy.com/login

# =============================================================================
# Elasticsearch Configuration
# =============================================================================

# Elasticsearch endpoint for log sources
# Default: https://pioneerc1-non-prod-usw2.es.us-west-2.aws.found.io:9243
PIONEER_ES_ENDPOINT=https://pioneerc1-non-prod-usw2.es.us-west-2.aws.found.io:9243

# Elasticsearch API key for authentication
# Get from AWS Secrets Manager or your Elasticsearch deployment
PIONEER_ES_API_KEY=your-elasticsearch-api-key-here

# Airo Builder Elasticsearch endpoint (for APM traces)
# Used for querying APM traces (traces-apm* indices)
# Example: https://airobuilde-non-prod-usw2.kb.us-west-2.aws.found.io:9243
AIRO_BUILDER_ES_ENDPOINT=https://airobuilde-non-prod-usw2.kb.us-west-2.aws.found.io:9243

# Airo Builder Elasticsearch API key (for APM traces)
# Get from AWS Secrets Manager or your Elasticsearch deployment
AIRO_BUILDER_ES_API_KEY=your-airo-builder-elasticsearch-api-key-here

# Control Plane Elasticsearch endpoint (for management/control plane logs)
# Example: https://pioneermgt-prod-usw2.es.us-west-2.aws.found.io:9243
CONTROL_PLANE_ES_ENDPOINT=

# Control Plane Elasticsearch API key
CONTROL_PLANE_ES_API_KEY=

# PDNA Elasticsearch endpoint (for PDNA logs)
# Example: https://mwpdata-prod-usw2.es.us-west-2.aws.found.io:9243
PDNA_ES_ENDPOINT=

# PDNA Elasticsearch API key
PDNA_ES_API_KEY=

# Optional: Custom prefix for analytics indices (default: airo_analytics_)
# ES_INDEX_PREFIX=airo_analytics_

# Environment name for index selection
# Options: dev, test, prod
# Determines which Elasticsearch indices to use (e.g., airo-agents-dev vs airo-agents-prod)
ENVIRONMENT_NAME=dev

# =============================================================================
# Loki Configuration (Optional - Alternative log backend)
# =============================================================================

# Loki endpoint URL (use Grafana proxy for access)
# Grafana proxy format: https://grafana.monitoring.gd3p.tools/api/datasources/proxy/uid/{datasource_uid}
# Example: https://grafana.monitoring.gd3p.tools/api/datasources/proxy/uid/ff18mpwxpc7wgd
# Default Grafana Loki datasource UID: ff18mpwxpc7wgd
LOKI_ENDPOINT=

# Loki API key for authentication
# Get from Grafana: https://grafana.monitoring.gd3p.tools
# Create a service account token with Viewer role
LOKI_API_KEY=

# Comma-separated list of log source IDs that should use Loki instead of Elasticsearch
# Available sources: airo-agents, airo-preview, airo-publish
# Leave empty to use Elasticsearch for all sources (default behavior)
# Example: LOKI_ENABLED_SOURCES=airo-agents
# Example: LOKI_ENABLED_SOURCES=airo-agents,airo-preview,airo-publish
LOKI_ENABLED_SOURCES=

# Note: When a source is enabled for Loki, all queries for that source will be
# routed to Loki instead of Elasticsearch. The frontend remains unchanged and
# shows the same interface regardless of backend.

# =============================================================================
# Langfuse Configuration
# =============================================================================

# Langfuse API endpoint
# Default: https://agentobser-agent-obs-langfuse-test.agentobser-test.prod.onkatana.net
LANGFUSE_BASE_URL=

# Langfuse API keys
# Get from Langfuse project settings
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Langfuse Project ID (for generating direct links to traces/users)
# Get from Langfuse URL: /project/{PROJECT_ID}/...
LANGFUSE_PROJECT_ID=

# =============================================================================
# Mgmt Airo Control Plane Configuration
# =============================================================================

# Base URL for the mgmt airo control plane
# Test: https://mgmt.nstk.net
# Prod: https://mgmt.woosaas.godaddy.com
MGMT_AIRO_BASE_URL=https://mgmt.nstk.net

# Inline client certificate and key for authenticating to the mgmt control plane
# Test cert CN:  console.airo-builder.test.authclient.int.godaddy.com
# Prod cert CN:  console.airo-builder.authclient.int.godaddy.com
CONSOLE_CERT="<cert_content>"
CONSOLE_KEY="<key_content>"

# =============================================================================
# Build/Deployment Configuration
# =============================================================================

# Katana artifact version (optional)
# Used for version tracking in health checks
# KATANA_ARTIFACT_VERSION=1.0.0

# =============================================================================
# Usage Instructions
# =============================================================================

# 1. Copy this file to .env.local:
#    cp env.example .env.local
#
# 2. Configure your Elasticsearch credentials:
#    Set PIONEER_ES_ENDPOINT and PIONEER_ES_API_KEY
#
# 3. For local development, authentication is automatically bypassed
#    when NODE_ENV=development or BYPASS_AUTH=true
#
# 4. Set ENVIRONMENT_NAME to match your environment (dev/test/prod)
#    This determines which Elasticsearch indices are used
#
# 5. (Optional) Configure Loki for specific log sources:
#    Set LOKI_ENDPOINT, LOKI_API_KEY, and add source IDs to LOKI_ENABLED_SOURCES
#    Sources in LOKI_ENABLED_SOURCES will query Loki instead of Elasticsearch
#
# Note: Environment variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Never put sensitive secrets in NEXT_PUBLIC_ variables.
