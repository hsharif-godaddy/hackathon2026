{
  "name": "debug-console",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "pnpm turbo run build --filter=@airo/shared --filter=@airo/ai-lib",
    "dev": "NEXT_TELEMETRY_DISABLED=1 tsx watch server.ts",
    "build": "next build",
    "start": "tsx server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@airo/ai-lib": "workspace:*",
    "@airo/shared": "workspace:*",
    "@aws-sdk/client-lambda": "^3.1048.0",
    "@aws-sdk/client-s3": "^3.1049.0",
    "@aws-sdk/client-secrets-manager": "^3.1049.0",
    "@aws-sdk/s3-request-presigner": "^3.1049.0",
    "@elastic/elasticsearch": "catalog:",
    "archiver": "catalog:",
    "echarts": "catalog:",
    "echarts-for-react": "catalog:",
    "gd-auth": "catalog:",
    "gd-auth-client": "catalog:",
    "hyparquet": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-markdown": "catalog:",
    "recharts": "^2.15.4",
    "remark-gfm": "catalog:",
    "tsx": "catalog:"
  },
  "devDependencies": {
    "@airo/eslint-config": "workspace:*",
    "@types/archiver": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-config-next": "16.2.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
