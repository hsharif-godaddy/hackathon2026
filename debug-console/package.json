{
  "name": "debug-console",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "next build",
    "start": "tsx server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "next lint --max-warnings 0",
