{
  "name": "@airo/image-search-eval",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "eval": "node --env-file=.env node_modules/.bin/tsx index.ts",
    "eval:v2": "node --env-file=.env node_modules/.bin/tsx index.ts --scenarios=scenarios-v2.json",
    "eval:v3": "node --env-file=.env node_modules/.bin/tsx index.ts --scenarios=scenarios-v3.json",
    "eval:dry-run": "node --env-file=.env node_modules/.bin/tsx index.ts --dry-run",
    "eval:quick": "node --env-file=.env node_modules/.bin/tsx index.ts --limit=1",
    "report": "tsx report.ts"
  },
  "dependencies": {
    "tsx": "^4.7.0"
  }
}
