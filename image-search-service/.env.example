# Image Search Service - Environment Configuration
# Copy to .env and fill in required values

# AWS Profile (use the SSO profile set up by ./setup.sh)
# Run: aws sso login --profile airobuild-dev-private-sso
AWS_PROFILE=airobuild-dev-private-sso
AWS_REGION=us-west-2

# Service
PORT=8080
LOG_LEVEL=info

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_COLLECTION=image_analyses
QDRANT_API_KEY=

# Getty Images API
# Auth type: "sso-jwt" (direct to Getty proxy, default) or "bearer" (via airo-builder proxy)
GETTY_AUTH_TYPE=sso-jwt
GETTY_UPSTREAM=https://getty-images-proxy.api.godaddy.com
GETTY_X_APP_KEY=airo-app-builder
GETTY_RATE_LIMIT_RPS=50
GETTY_CONCURRENCY=10

# SSO JWT auth (when GETTY_AUTH_TYPE=sso-jwt)
# Client cert/key from Secrets Manager for SSO token exchange
# Pull certs: aws secretsmanager get-secret-value --secret-id /Katana/Secrets/airobuilde/proxy/dev-private-ecs/GETTY_CERT --profile airobuild-dev-private-sso --query "SecretString" --output text > certs/client.crt
# Pull key:   aws secretsmanager get-secret-value --secret-id /Katana/Secrets/airobuilde/proxy/dev-private-ecs/GETTY_KEY --profile airobuild-dev-private-sso --query "SecretString" --output text > certs/client.key
GETTY_CERT_PATH=certs/client.crt
GETTY_KEY_PATH=certs/client.key
GETTY_SSO_HOST=sso.godaddy.com

# Bearer token auth (when GETTY_AUTH_TYPE=bearer, for airo-builder proxy)
# GETTY_TOKEN: Bearer token from Secrets Manager
# To get: aws secretsmanager get-secret-value --secret-id /Katana/Secrets/airobuilde/app/dev-private-ecs/GETTY_TOKEN --profile airobuild-dev-private-sso --query "SecretString" --output text
GETTY_TOKEN=

# Anthropic API (Haiku for image analysis) - via GoCode proxy
ANTHROPIC_API_URL=https://caas-gocode-prod.caas-prod.prod.onkatana.net
ANTHROPIC_API_KEY=
HAIKU_RATE_LIMIT_RPS=20
HAIKU_CONCURRENCY=5

# OpenAI API (Embeddings) - via GoCode proxy
OPENAI_API_KEY=
OPENAI_BASE_URL=https://caas-gocode-prod.caas-prod.prod.onkatana.net

# S3 Backup Storage (shared bucket for caching analyses across developers)
# This bucket is created by the CDK stack - see cdk/lib/image-search-stack.ts
S3_BUCKET=airo-image-analyses-dev
S3_REGION=us-west-2
S3_PREFIX=analyses/v1

# Response Behavior
DEFAULT_MIN_CACHED=5
DEFAULT_MAX_WAIT_SECONDS=30

# SSO (for auth)
SSO_HOST=sso.godaddy.com

# APM (optional)
ELASTIC_APM_SERVER_URL=
ELASTIC_APM_SERVICE_NAME=image-search-service
ELASTIC_APM_ENVIRONMENT=dev
