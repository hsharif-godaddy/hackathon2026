{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["REAL_PNPM", "WORKSPACE_ROOT"],
  "globalDependencies": ["packages/eslint-config-airo/index.cjs"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": ["**/*.tsbuildinfo"]
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "passThroughEnv": ["NODE_OPTIONS"]
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "outputs": [],
      "passThroughEnv": ["NODE_OPTIONS"]
    }
  }
}
