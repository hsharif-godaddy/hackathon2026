{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["REAL_PNPM", "WORKSPACE_ROOT"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": ["**/*.tsbuildinfo"]
    },
    "lint": {
      "outputs": []
    }
  }
}
