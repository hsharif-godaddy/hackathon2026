{
  "name": "@airo/agents",
  "version": "0.1.0",
  "description": "Class-based AI agent library with HTTP streaming endpoints",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "dev": "pnpm run prebuild && tsx watch --env-file=.env src/server/app.ts",
    "prebuild": "cd ../packages/ai-lib && pnpm run build",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file=.env dist/server/app.js",
    "test": "vitest run",
    "test:unit": "vitest run --exclude='**/*.integration.test.ts'",
    "test:integration": "vitest run 'src/**/*.integration.test.ts'",
    "test:watch": "vitest --watch",
    "test:watch:unit": "vitest --watch --exclude='**/*.integration.test.ts'",
    "test:watch:integration": "vitest --watch 'src/**/*.integration.test.ts'",
    "test:coverage": "vitest run --coverage",
    "test:coverage:unit": "vitest run --coverage --exclude='**/*.integration.test.ts'",
    "test:sse": "node tests/test-sse.js",
    "debug:conversation": "tsx --env-file=.env debug-conversation-history.ts",
    "debug:history": "tsx --env-file=.env scripts/debug-history-phases.ts",
    "debug:messages": "tsx --env-file=.env scripts/debug-messages.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^4.0.0-beta.87",
    "@ai-sdk/anthropic": "^3.0.0-beta.77",
    "@ai-sdk/openai": "^3.0.0-beta.88",
    "@airo/ai-lib": "workspace:*",
    "@anthropic-ai/tokenizer": "^0.0.4",
    "@aws-sdk/credential-providers": "^3.888.0",
    "@babel/generator": "^7.28.0",
    "@babel/parser": "^7.28.0",
    "@babel/traverse": "^7.28.0",
    "@babel/types": "^7.28.0",
    "@openai/agents": "^0.0.17",
    "@qdrant/js-client-rest": "^1.15.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/socket.io": "^3.0.2",
    "ai": "^6.0.0-beta.138",
    "axios": "^1.12.0",
    "better-sqlite3": "^12.2.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "diff": "^8.0.2",
    "elastic-apm-node": "^4.13.0",
    "execa": "^9.6.0",
    "express": "^4.18.2",
    "glob": "^11.0.3",
    "gray-matter": "^4.0.3",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "jwt-decode": "^4.0.0",
    "magic-string": "0.30.17",
    "minimatch": "^10.0.3",
    "multer": "^2.0.2",
    "mysql2": "^3.14.3",
    "nanoid": "^5.1.5",
    "openai": "^5.12.2",
    "rsa-pem-from-mod-exp": "^0.8.6",
    "socket.io": "^4.8.1",
    "sqlite3": "^5.1.7",
    "tiktoken": "^1.0.22",
    "uuid": "^11.1.0",
    "ws": "^8.14.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/babel__generator": "^7.6.8",
    "@types/babel__traverse": "^7.20.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/diff": "^7.0.2",
    "@types/express": "^4.17.21",
    "@types/glob": "^8.1.0",
    "@types/node": "^22.18.12",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eventsource": "^4.0.0",
    "prettier": "^3.1.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.10.0"
  }
}
