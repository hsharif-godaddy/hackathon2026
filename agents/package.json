{
  "name": "@airo/agents",
  "version": "0.1.0",
  "description": "Class-based AI agent library with HTTP streaming endpoints",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/app.ts",
    "build": "tsc",
    "start": "node dist/server/app.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:sse": "node test-sse.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "dependencies": {
    "@godaddy/agent-sdk": "^1.3.2",
    "@openai/agents": "^0.0.17",
    "axios": "^1.6.0",
    "better-sqlite3": "^12.2.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "diff": "^8.0.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "glob": "^11.0.3",
    "helmet": "^7.1.0",
    "jwt-decode": "^4.0.0",
    "minimatch": "^10.0.3",
    "nanoid": "^5.1.5",
    "openai": "^5.12.2",
    "sqlite3": "^5.1.7",
    "uuid": "^11.1.0",
    "ws": "^8.14.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/diff": "^7.0.2",
    "@types/express": "^4.17.21",
    "@types/glob": "^8.1.0",
    "@types/node": "^20.10.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eventsource": "^4.0.0",
    "node-fetch": "^3.3.2",
    "prettier": "^3.1.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
