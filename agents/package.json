{
  "name": "@airo/agents",
  "version": "0.1.0",
  "description": "Class-based AI agent library with HTTP streaming endpoints",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./assessment-agent": {
      "types": "./dist/agents/assessment-agent/index.d.ts",
      "import": "./dist/agents/assessment-agent/index.js"
    },
    "./tools": {
      "types": "./dist/tools/ai-lib-tools/index.d.ts",
      "import": "./dist/tools/ai-lib-tools/index.js"
    }
  },
  "scripts": {
    "dev": "GASKET_ENV=local.dev NODE_OPTIONS='--max-old-space-size=1536' node load-env.cjs pnpm run dev:watch",
    "dev:log": "GASKET_ENV=local.dev NODE_OPTIONS='--max-old-space-size=1536' node load-env.cjs pnpm run dev:watch | tee /tmp/agents.log",
    "dev:watch": "NODE_OPTIONS='--max-old-space-size=1536' pnpm run build:deps && node --import tsx --watch --watch-path=src src/server/app.ts",
    "local:test": "GASKET_ENV=local.test NODE_OPTIONS='--max-old-space-size=1536' node load-env.cjs pnpm run dev:watch",
    "local:prod": "GASKET_ENV=local.prod NODE_OPTIONS='--max-old-space-size=1536' node load-env.cjs pnpm run dev:watch",
    "build:deps": "pnpm exec turbo run build --filter=@airo/agents^...",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file=.env dist/server/app.js",
    "test": "NODE_OPTIONS='--max-old-space-size=512' vitest run --exclude='**/*.integration.test.ts'",
    "test:unit": "NODE_OPTIONS='--max-old-space-size=512' vitest run --exclude='**/*.integration.test.ts'",
    "test:integration": "NODE_OPTIONS='--max-old-space-size=512' vitest run 'src/**/*.integration.test.ts'",
    "test:watch": "NODE_OPTIONS='--max-old-space-size=512' vitest --watch",
    "test:watch:unit": "NODE_OPTIONS='--max-old-space-size=512' vitest --watch --exclude='**/*.integration.test.ts'",
    "test:watch:integration": "NODE_OPTIONS='--max-old-space-size=512' vitest --watch 'src/**/*.integration.test.ts'",
    "test:coverage": "NODE_OPTIONS='--max-old-space-size=512' vitest run --coverage",
    "test:coverage:unit": "NODE_OPTIONS='--max-old-space-size=512' vitest run --coverage --exclude='**/*.integration.test.ts'",
    "test:sse": "node tests/test-sse.js",
    "debug:conversation": "tsx --env-file=.env debug-conversation-history.ts",
    "debug:history": "tsx --env-file=.env scripts/debug-history-phases.ts",
    "debug:messages": "tsx --env-file=.env scripts/debug-messages.ts",
    "test:summarization": "tsx --env-file=.env scripts/test-summarization.ts",
    "trigger:summarization": "tsx --env-file=.env scripts/trigger-summarization.ts",
    "view:summaries": "tsx --env-file=.env scripts/view-summaries.ts",
    "delete:summaries": "tsx --env-file=.env scripts/delete-summaries.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "devtools": "npx @ai-sdk/devtools",
    "eval:fetch": "tsx scripts/image-analysis-eval/fetch-test-images.ts",
    "eval:analyze": "tsx scripts/image-analysis-eval/run-analysis.ts",
    "eval:report": "tsx scripts/image-analysis-eval/generate-report.ts",
    "eval:viewer": "npx serve scripts/image-analysis-eval -p 3333",
    "eval:load": "tsx scripts/image-analysis-eval/load-to-qdrant.ts",
    "eval:search": "tsx scripts/image-analysis-eval/test-search.ts",
    "eval:quick": "tsx scripts/image-analysis-eval/quick-import.ts --",
    "eval:all": "pnpm eval:fetch && pnpm eval:analyze && pnpm eval:report",
    "eval:fetch:websites": "tsx scripts/image-analysis-eval/fetch-test-images.ts -- --input=test-images-websites.json --output=fetched-images-websites.json",
    "eval:analyze:websites": "tsx scripts/image-analysis-eval/run-analysis.ts -- --input=fetched-images-websites.json --output=analysis-results-websites.json",
    "benchmark:memory": "tsx src/services/summarization/__benchmarks__/memory-benchmark.ts",
    "benchmark:memory:gc": "NODE_OPTIONS='--expose-gc' tsx src/services/summarization/__benchmarks__/memory-benchmark.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.64",
    "@ai-sdk/devtools": "^0.0.15",
    "@ai-sdk/mcp": "^1.0.30",
    "@ai-sdk/openai": "^3.0.49",
    "@airo/ai-common": "workspace:*",
    "@airo/ai-grants": "workspace:*",
    "@airo/ai-lib": "workspace:*",
    "@airo/ai-skills": "workspace:*",
    "@airo/ai-transport": "workspace:*",
    "@airo/shared": "workspace:*",
    "@babel/generator": "^7.28.0",
    "@babel/parser": "^7.28.0",
    "@babel/traverse": "^7.28.0",
    "@babel/types": "^7.28.0",
    "@godaddy/agent-observability-events": "^1.4.0",
    "@godaddy/agent-otel-sdk": "^1.3.0",
    "@godaddy/goknowb-client": "^1.0.9",
    "@langfuse/otel": "^4.5.1",
    "@langfuse/tracing": "^4.6.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-node": "^0.208.0",
    "@qdrant/js-client-rest": "^1.15.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "ai": "^6.0.141",
    "ai-tokenizer": "^1.0.6",
    "archiver": "^7.0.0",
    "better-sqlite3": "^12.2.0",
    "compression": "^1.7.4",
    "cors": "^2.8.6",
    "diff": "^8.0.4",
    "elastic-apm-node": "^4.13.0",
    "execa": "^9.6.0",
    "express": "^4.22.1",
    "express-rate-limit": "^7.4.1",
    "gd-auth": "1.4.1",
    "glob": "^11.1.0",
    "gray-matter": "^4.0.3",
    "helmet": "^7.1.0",
    "isomorphic-dompurify": "^2.36.0",
    "jsdom": "^24.0.0",
    "jsonwebtoken": "^9.0.3",
    "jwt-decode": "^4.0.0",
    "magic-string": "0.30.17",
    "minimatch": "^10.0.3",
    "multer": "^2.1.1",
    "mysql2": "^3.20.0",
    "nanoid": "^5.1.7",
    "openai": "^6.0.0",
    "qrcode": "^1.5.4",
    "rsa-pem-from-mod-exp": "^0.8.6",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "uuid": "^11.1.0",
    "ws": "^8.14.2",
    "yauzl": "^2.10.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@airo/eslint-config": "workspace:*",
    "@opentelemetry/sdk-trace-node": "^2.6.1",
    "@types/archiver": "^6.0.2",
    "@types/babel__generator": "^7.6.8",
    "@types/babel__traverse": "^7.20.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.18.12",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.10",
    "@types/yauzl": "^2.10.3",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eventsource": "^4.0.0",
    "prettier": "^3.1.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.10.0"
  }
}
