# Airo Builder - Agents Environment Configuration Example
# Copy this file to .env and configure the values for your environment
# cp .env.example .env

# =============================================================================
# Environment Configuration
# =============================================================================
#
# This service supports environment-specific configuration via .env.local.{dev|test|prod} files
# These files are automatically generated by the setup script and loaded based on GASKET_ENV:
#
# - .env.local.dev  → Loaded with: pnpm --filter @airo/agents run dev
# - .env.local.test → Loaded with: pnpm --filter @airo/agents run local:test
# - .env.local.prod → Loaded with: pnpm --filter @airo/agents run local:prod
#
# Environment-specific files override settings in this base .env file
#
NODE_ENV=development

# =============================================================================
# Authentication Configuration
# =============================================================================

# Authentication Type (RECOMMENDED - New System)
# Controls all authentication behavior across the agents service
# Possible values:
#   - jwt: Full JWT authentication with app (Recommended for local development)
#   - mock: Mock authentication with test users (development/testing)
#   - none: No authentication (legacy, some UI functionalities degraded)
# Default: Automatically determined by NODE_ENV (development=mock, production=jwt)
# Note: Use 'jwt' for proper local testing - this ensures app and agents auth works end-to-end
AUTH_TYPE=jwt

# Legacy Authentication Setting (DEPRECATED - Use AUTH_TYPE instead)
# BYPASS_AUTH_FOR_LOCAL=true

# SSO Configuration for JOMAX token validation
# Used by diagnostics endpoint to validate debug-console tokens
# Generated automatically by setup.sh based on environment
# Valid values: sso.dev-godaddy.com, sso.test-godaddy.com, sso.godaddy.com
# SSO_HOST=sso.dev-godaddy.com

# =============================================================================
# AI Model Configuration
# =============================================================================
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://caas-gocode-prod.caas-prod.prod.onkatana.net"
OPENAI_MODEL="claude-sonnet-4"

# =============================================================================
# Application Configuration
# =============================================================================
APP_TEMPLATE_DIR='app-templates/v8'
SHOW_USAGE_COST=true

# Agent Enablement Configuration
# Control which AI agents are available in the system
# Database Agent: Specialized agent for MySQL database operations and backend coordination
# Set to 'true' to enable in local development environments
# Default: false (disabled by default, opt-in for local development)
ENABLE_DATABASE_AGENT=false

# Commerce Agent: Specialized agent for GoDaddy Commerce product catalog operations
# Set to 'true' to enable in development/testing environments
# Default: false (disabled by default, opt-in for local development)
ENABLE_COMMERCE_AGENT=false

# Social Features: Adds social platform integration and post management tools to Marketing Agent
# Includes connecting to platforms (Facebook, Instagram, Google Business Profile, TikTok, Yelp, WhatsApp)
# and tools for social media post creation, management, and publishing
# Set to 'true' to enable in development/testing environments
# Default: false (disabled by default, opt-in for local development)
ENABLE_SOCIAL=false

# =============================================================================
# Database Configuration (MySQL for app databases, not agent storage)
# =============================================================================
MYSQL_ROOT_HOST=localhost
MYSQL_ROOT_PORT=3306
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASS=

# =============================================================================
# JWT Configuration (Level 2: UI-to-Agents Authentication)
# =============================================================================

# JWKS endpoint URL for fetching builder's public keys to validate JWT tokens
# This is SEPARATE from customer SSO (Level 1) - it's for authenticating API calls from the builder
#
# The agents service validates JWT tokens issued by the builder app using the builder's
# public keys published at this JWKS endpoint (RFC 7517 standard)
#
# IMPORTANT: JWKS_URL is configured in environment-specific .env.local.{dev|test|prod} files
# automatically generated by the setup script. Each environment points to its corresponding
# builder JWKS endpoint:
#
# - .env.local.dev:  https://local.gasket.dev-godaddy.com:8443/.well-known/jwks.json
# - .env.local.test: https://airo-builder.test-godaddy.com/.well-known/jwks.json
# - .env.local.prod: https://airo-builder.godaddy.com/.well-known/jwks.json
#
# Default (if not set in env-specific files): https://airo-builder.test-godaddy.com/.well-known/jwks.json
#
# Site ID for JWT authorization (set by deployment system in production)
# Used to validate siteId claim in JWT tokens from the builder
# SITE_ID=default-site

# =============================================================================
# External Services Configuration
# =============================================================================

# GoDaddy OAuth Configuration (PKCE Flow)
# Used for user authorization flows (e.g., Commerce Agent OAuth widget)
# In production: GODADDY_OAUTH_CLIENT_SECRET and GODADDY_OAUTH_ENCRYPTION_KEY provided by control plane via /alloc/config.json
# In local development: Client secret and encryption key required for testing OAuth flows
# Note: Client ID is public and can be committed to the repository, in prod it is provided as an environment variable
GODADDY_OAUTH_CLIENT_ID=c16c68eb-0c20-437c-90bd-1c78911b3d48
GODADDY_OAUTH_CLIENT_SECRET=<client_secret_from_aws_secrets_manager>
GODADDY_OAUTH_ENCRYPTION_KEY=<encryption_key_from_aws_secrets_manager>

# GoDaddy API Configuration (REQUIRED)
# GODADDY_API_BASE_URL: Always from environment variables (both sandbox and deployed)
# AGENT_URL: Always from environment variables (used to construct OAuth redirect URI)
GODADDY_API_BASE_URL=https://api.dev-godaddy.com
AGENT_URL=http://localhost:4000

# Getty Images API Authentication (LEGACY - NOT related to authentication layers)
# This SSO_JWT token is ONLY used for authenticating with Getty Images API proxy
# It is NOT related to:
#   - Level 1: Customer SSO authentication (GoDaddy SSO)
#   - Level 2: Preview app JWT authentication (site-scoped JWTs)
SSO_JWT=<your_sso_jwt_token>
DAILY_PRICE_LIMIT=10

# Getty Images Configuration
GETTY_API_URL=https://airobuilde-proxy-dev-private-ecs.airobuilde-dev-private.prod.onkatana.net/img/search
GETTY_TOKEN=<getty_token_here_from_secrets_manager>
IMAGE_SEARCH_DRIVER=getty

# Logo Generation API
# Override URL for logo-agent REST API (defaults to environment-specific URL derived from GODADDY_API_BASE_URL)
# LOGO_API_URL=https://logo-agent.mvci.api.dev-godaddy.com

# Image/Video Generation API
# Override URL for imagegen-agent REST API (defaults to environment-specific URL derived from GODADDY_API_BASE_URL)
# IMAGEGEN_API_URL=https://imagegen-agent.mvci.api.dev-godaddy.com

# AI Image Analysis: Uses Claude Haiku to analyze Getty Images for relevance filtering
# When enabled, searches return images scored by semantic relevance to the search prompt
# Set to 'true' to enable (disabled by default, opt-in feature)
# Note: Even when enabled, analysis can be disabled per-request via the analyzeImages parameter
# IMAGE_ANALYSIS_ENABLED=true

# Media Slots: Enables slot-based media management for images and videos
# When enabled, the develop agent uses the 'media' tool which stores images in airo-media.json
# manifest and returns proxy URLs (/airo-assets/images/{slot}) instead of direct Getty URLs
# This allows users to swap images without code changes via the image replacement UI
# Set to 'true' to enable (disabled by default, opt-in feature)
# ENABLE_MEDIA_SLOTS=true

# Knowledge Service (for RAG documentation retrieval)
# When set, knowledge-service is used for RAG retrieval instead of KnowB.
# Leave unset to fall back to KnowB (KNOWB_URL / GODADDY_API_BASE_URL).
#
# Direct mode (dev/staging — calls knowledge-service directly):
# KNOWLEDGE_SERVICE_URL=https://knowledge.airo-builder.dev-godaddy.com
#
# Proxy mode (production — routes through airo-proxy):
# KNOWLEDGE_PROXY_URL=https://<proxy-host>/v1/knowledge
# Auth uses GETTY_TOKEN (the shared airo-proxy Bearer token)

# KnowB Knowledge Base URL (for image analysis caching)
# Used by the image analysis service to cache and retrieve image metadata
# Falls back to GODADDY_API_BASE_URL if not set, then to test environment
# KNOWB_URL=https://knowb.api.int.test-godaddy.com

# KnowB node ID for image analysis caching
# The /airo_media_v2 node is used in production; use /airo_info for local testing if /airo_media_v2 is inaccessible
# IMAGE_ANALYSIS_KB_NODE_ID=/airo_info

# Download files tmp dir
DOWNLOAD_TEMP_DIR="/tmp/apps/archives"

# Commerce Checkout Configuration
CHANNEL_ID=web

# =============================================================================
# Debugging & Development Tools
# =============================================================================

# AI SDK DevTools: Web-based UI for debugging LLM interactions
# Captures requests, responses, tool calls, and multi-step agent runs
# View at http://localhost:4983 after running: pnpm devtools
# WARNING: Stores all AI interactions in plain text - use only in local development
# Set to 'true' to enable, 'false' to explicitly disable (even in development)
# Default: Enabled when NODE_ENV=development (unless explicitly set to 'false')
ENABLE_AI_DEVTOOLS=true

# =============================================================================
# Langfuse Configuration (Optional - LLM observability)
# =============================================================================
# Langfuse provides tracing and analytics for LLM calls
# Only initialized when both keys are present - safe to leave unset for local development
# LANGFUSE_PUBLIC_KEY=pk-lf-xxx
# LANGFUSE_SECRET_KEY=sk-lf-xxx
# LANGFUSE_HOST=https://cloud.langfuse.com

# =============================================================================
# Elastic APM Configuration (Optional - for local APM debugging)
# =============================================================================
# See docs/LOCAL_APM_SETUP.md for setup instructions
# ELASTIC_APM_SERVER_URL=http://localhost:8200
# ELASTIC_APM_SECRET_TOKEN=local-dev-token
