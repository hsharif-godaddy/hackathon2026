# Copy this over:
# cp .env.example .env
# Then modify to suit your needs

NODE_ENV=development

OPENAI_API_KEY=""
OPENAI_BASE_URL="https://caas-gocode-prod.caas-prod.prod.onkatana.net"
OPENAI_MODEL="claude-sonnet-4"

APP_TEMPLATE_DIR='app-templates/v3'
SHOW_USAGE_COST=true

# MySQL configuration
MYSQL_ROOT_HOST=localhost
MYSQL_ROOT_PORT=3306
MYSQL_ROOT_USER=root #should be root user
MYSQL_ROOT_PASS=
SSO_JWT=<your_sso_jwt_token>
