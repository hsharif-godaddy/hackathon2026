# Airo AI Builder - Environment Configuration Example
# Copy this file to .env.local and configure the values for your environment

# =============================================================================
# API Configuration - REMOVED (Dynamic URLs Only)
# =============================================================================

# ⚠️ BREAKING CHANGE: Static API URLs are no longer used
# All agent API URLs are now dynamic based on site data from the database
# Each site has its own dedicated agent container with a unique URL
#
# Migration: Use buildDynamicApiUrl(endpoint, siteId) and buildDynamicWsUrl(endpoint, siteId)

# =============================================================================
# Authentication Configuration
# =============================================================================

# Authentication Architecture Overview
# ====================================
# This application uses TWO SEPARATE authentication layers:
#
# LEVEL 1: Customer/User Authentication (GoDaddy SSO)
#   - Variables: SSO_LOGIN_URL, SSO_LOGOUT_URL, LOGIN_REDIRECT_URL, AUTH_TYPE
#   - Purpose: Authenticate users logging into the Airo Builder application
#   - Sets: auth_idp cookie on builder domain (.dev-godaddy.com, etc.)
#   - See: app/src/lib/gd-auth-service.ts
#
# LEVEL 2: Preview App & Agent Authentication (Site-Scoped JWT)
#   - Variables: NEXT_PUBLIC_APP_URL, JWT_PRIVATE_KEY, JWT_PUBLIC_KEY
#   - Purpose: Authenticate preview apps on different domains and agent API calls
#   - Uses: Builder issues site-scoped JWT tokens validated via JWKS endpoint
#   - See: docs/preview-app-authentication.md, docs/ui-agents-authentication-architecture.md
#
# For detailed architecture documentation:
# - docs/preview-app-authentication.md
# - docs/ui-agents-authentication-architecture.md

# Authentication Type
# Controls all authentication behavior across the application
# Possible values:
#   - mock: Mock authentication with test users (development/testing)
#   - jwt: Full JWT authentication with SSO (production)
# Default: Automatically determined by NODE_ENV (development=mock, production=jwt)
AUTH_TYPE=mock

# Builder Application URL (Level 2 JWT Authentication)
# ===================================================
# REQUIRED for preview app JWT authentication and iframe security
# Used to construct JWKS endpoint URL for dev-supervisor JWT validation
#
# This variable is automatically set in environment-specific files generated by setup:
# - .env.local.dev  → https://local.gasket.dev-godaddy.com:8443
# - .env.local.test → https://airo-builder.test-godaddy.com
# - .env.local.prod → https://airo-builder.godaddy.com
#
# Preview apps fetch the builder's public keys from: {NEXT_PUBLIC_APP_URL}/.well-known/jwks.json
#
# Only override this if you need custom builder URL configuration
# NEXT_PUBLIC_APP_URL=https://local.gasket.dev-godaddy.com:8443

# JWT Keys for Agent Authentication (REQUIRED for agent communication)
# These keys are used to sign and verify JWT tokens for agent API calls
# Generate keys using: node scripts/generate-jwt-keys.js
# Keep JWT_PRIVATE_KEY secure and never commit it to version control!
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# SSO Configuration (Used when AUTH_TYPE=jwt)
# SSO Login URL - Default: https://sso.test-godaddy.com/login
SSO_LOGIN_URL=https://sso.test-godaddy.com/login

# SSO Logout URL - Default: https://sso.test-godaddy.com/logout
SSO_LOGOUT_URL=https://sso.test-godaddy.com/logout

# SSO App Name - registered app identifier sent as ?app= to SSO
# Must match the app registered with GoDaddy SSO for correct redirect.
# Default: airo-builder (redirects to airo-builder.test-godaddy.com)
# Pre-test: pre-test-airo-builder (redirects to pre-test-airo-builder.test-godaddy.com)
#SSO_APP_NAME=airo-builder

# Login Redirect URL (where users go after successful login)
# Default: https://airo-builder.test-godaddy.com/
LOGIN_REDIRECT_URL=https://airo-builder.test-godaddy.com/

# Logout Redirect URL (where users go after logout)
# Default: https://airo-builder.test-godaddy.com/
LOGOUT_REDIRECT_URL=https://airo-builder.test-godaddy.com/

# TLS Certificate Verification (Security Configuration)
# WARNING: Only disable in development for certificate debugging
# Never set DISABLE_TLS_VERIFICATION=true in production - it creates security vulnerability
# Default: TLS verification enabled (secure)
# DISABLE_TLS_VERIFICATION=false

# Set to true for local Nomad development with self-signed certificates
DISABLE_TLS_VERIFICATION=true

# TEMPORARY: Use API proxy for agent calls to bypass SSL issues in testing
# Set to 'false' or remove for production when SSL certificates are fixed
USE_AGENT_PROXY=true

# =============================================================================
# Application Performance Monitoring (APM) Configuration
# =============================================================================

# OpenTelemetry via Gasket OTel (automatic instrumentation)
# Required for production - get from AWS Secrets Manager: elastic_otel_credentials
# Example: CREDS=$(aws secretsmanager get-secret-value --secret-id elastic_otel_credentials --query SecretString --output text)
# OTEL_EXPORTER_OTLP_ENDPOINT=$(echo $CREDS | jq -r '.ingestion_url')
# OTEL_EXPORTER_OTLP_HEADERS=$(echo $CREDS | jq -r '.auth_header')
#
# Expected format from AWS Secrets:
# OTEL_EXPORTER_OTLP_ENDPOINT=https://[deployment-id].apm.us-west-2.aws.found.io:9243
# OTEL_EXPORTER_OTLP_HEADERS="Authorization=ApiKey <apm_api_key>"

# Optional - defaults shown
# OTEL_SERVICE_NAME=airo-app-builder
# NEXT_OTEL_VERBOSE=1

# Legacy - Elastic APM native agent (not used, OTel preferred)
# ELASTIC_APM_SERVER_URL=https://your-elastic-apm-server:8200
# ELASTIC_APM_SECRET_TOKEN=your-secret-token

# =============================================================================
# AI/LLM Configuration (for AI-generated app names and features)
# =============================================================================

# OpenAI API Key for AI-powered features (app name generation, etc.)
# Required for AI app name generation during site creation
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Optional: OpenAI Base URL (for custom proxy or different endpoint)
# Default: Uses OpenAI's default API endpoint
# OPENAI_BASE_URL=https://api.openai.com

# Optional: OpenAI Model to use for text generation
# Default: Uses the model configured in the agents service
# OPENAI_MODEL="claude-sonnet-4"

# =============================================================================
# GoDaddy OAuth Configuration (for generated apps)
# =============================================================================

# GoDaddy OAuth secret is provisioned to generated apps via /alloc/config.json
# Client ID is provisioned to generated apps as an environment variable
# These credentials enable generated apps to authenticate with GoDaddy APIs
GODADDY_OAUTH_CLIENT_ID=c16c68eb-0c20-437c-90bd-1c78911b3d48
GODADDY_OAUTH_CLIENT_SECRET=<client_secret_from_aws_secrets_manager>

# GoDaddy API Base URL (also passed as environment variable to containers)
# Default: https://api.dev-godaddy.com
GODADDY_API_BASE_URL=https://api.dev-godaddy.com

# =============================================================================
# Social Platform Configuration
# =============================================================================

# Social Platform API Base URL for OAuth authentication
# This is a NEXT_PUBLIC_ variable because it's used in the frontend
# Development: https://social-auth.api.dev-godaddy.com
# Test: https://social-auth.api.test-godaddy.com
# Production: https://social-auth.api.godaddy.com
NEXT_PUBLIC_SOCIAL_AUTH_API_URL=https://social-auth.api.dev-godaddy.com

# Social Platform V2 API Base URL for connection management
# This is a NEXT_PUBLIC_ variable because it's used in the frontend
# Development: https://social-v2.api.dev-godaddy.com
# Test: https://social-v2.api.test-godaddy.com
# Production: https://social-v2.api.godaddy.com
NEXT_PUBLIC_SOCIAL_V2_API_URL=https://social-v2.api.dev-godaddy.com

# =============================================================================
# GraphQL API Configuration (Product Graph)
# =============================================================================

# GraphQL API Endpoint for Product Graph (venture management, profiles, etc.)
# Default: https://api.godaddy.com/graphql
GRAPHQL_ENDPOINT=https://api.godaddy.com/graphql

# GraphQL S2S Authentication (Certificate-based)
# Option 1: Provide certificate content directly in environment variables (recommended for containers)
# GRAPHQL_CLIENT_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# GRAPHQL_CLIENT_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Option 2: Provide file paths to certificate files (used if env vars above are not set)
GRAPHQL_CLIENT_CERT_PATH=/workspace/app/certs/graphql-client.crt
GRAPHQL_CLIENT_KEY_PATH=/workspace/app/certs/graphql-client.key

# GraphQL SSO Endpoint for S2S token generation
# Default: https://sso.test-godaddy.com/v1/secure/api/token
GRAPHQL_SSO_ENDPOINT=https://sso.test-godaddy.com/v1/secure/api/token

# GraphQL SSO Realm (for certificate-based auth)
# Default: cert
GRAPHQL_SSO_REALM=cert

# GraphQL Token Expiry (in seconds, fallback if JWT doesn't contain exp)
# Default: 3000 (50 minutes)
GRAPHQL_TOKEN_EXPIRY=3000

# =============================================================================
# TestPilot AI API Configuration
# =============================================================================

# TestPilot S2S Authentication (Certificate-based) - REQUIRED
# TESTPILOT_CLIENT_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# TESTPILOT_CLIENT_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# TestPilot API Endpoint (optional, defaults to production)
# TESTPILOT_API_ENDPOINT=https://testpilotai.api.ta.dev-godaddy.com/api/tests/ai-run

# TestPilot SSO Endpoint for S2S token generation
# Default: https://sso.test-godaddy.com/v1/secure/api/token
TESTPILOT_SSO_ENDPOINT=https://sso.test-godaddy.com/v1/secure/api/token

# =============================================================================
# Control Plane Configuration (mgmt-airo)
# =============================================================================

# mgmt-airo Base URL (control plane API endpoint)
# Default: https://mgmt.nstk.net
MGMT_AIRO_BASE_URL=https://mgmt.nstk.net

# mgmt-airo Datacenter (where to provision infrastructure)
# Default: sxb1
MGMT_AIRO_DATACENTER=sxb1

# mgmt-airo Product ID (product identifier for billing/provisioning)
# Default: aab-v1
MGMT_AIRO_PRODUCT_ID=aab-v1

# =============================================================================
# Analytics / Insights Configuration
# =============================================================================

# UIP Insights GraphQL API URL
# Default: https://uip.api.int.test-godaddy.com/v1/insights/graphql (test env)
# Production: https://uip.api.int.godaddy.com/v1/insights/graphql
# UIP_INSIGHTS_API_URL=https://uip.api.int.test-godaddy.com/v1/insights/graphql

# =============================================================================
# V2 Testing Configuration (IMPORTANT: Read This!)
# =============================================================================

# ⚠️  CRITICAL: V2 mode requires DIFFERENT SSO environment than Legacy mode
#
# Legacy Mode: Uses sso.dev-godaddy.com
# V2 Mode:     Uses sso.test-godaddy.com (mgmt-airo requirement)
#
# When testing V2 (USE_V2_CONTROL_PLANE=true), you MUST change SSO URLs:

# FOR LOCAL DEVELOPMENT (recommended - use ./setup.sh to generate):
# SSO_LOGIN_URL=https://sso.dev-godaddy.com/login
# SSO_LOGOUT_URL=https://sso.dev-godaddy.com/logout
# LOGIN_REDIRECT_URL=https://local.gasket.dev-godaddy.com:8443/
# LOGOUT_REDIRECT_URL=https://local.gasket.dev-godaddy.com:8443/

# FOR V2 TESTING AGAINST CLOUD DEV:
# SSO_LOGIN_URL=https://sso.test-godaddy.com/login
# SSO_LOGOUT_URL=https://sso.test-godaddy.com/logout
# LOGIN_REDIRECT_URL=https://airo-builder.dev-godaddy.com/
# LOGOUT_REDIRECT_URL=https://airo-builder.dev-godaddy.com/

# FOR LEGACY TESTING AGAINST CLOUD DEV:
# SSO_LOGIN_URL=https://sso.dev-godaddy.com/login
# SSO_LOGOUT_URL=https://sso.dev-godaddy.com/logout
# LOGIN_REDIRECT_URL=https://airo-builder.dev-godaddy.com/
# LOGOUT_REDIRECT_URL=https://airo-builder.dev-godaddy.com/

# =============================================================================
# V2 Testing Setup Instructions
# =============================================================================

# 1. For local development (recommended):
#    Run: ./setup.sh
#    This generates .env with local.gasket.dev-godaddy.com:8443 configuration

# 2. For V2 Testing against cloud dev environment, update .env with:
#    USE_V2_CONTROL_PLANE=true
#    SSO_LOGIN_URL=https://sso.test-godaddy.com/login
#    SSO_LOGOUT_URL=https://sso.test-godaddy.com/logout
#    LOGIN_REDIRECT_URL=https://airo-builder.dev-godaddy.com/
#    LOGOUT_REDIRECT_URL=https://airo-builder.dev-godaddy.com/
#    MGMT_AIRO_BASE_URL=https://mgmt.nstk.net
#    MGMT_AIRO_DATACENTER=sxb1
#    MGMT_AIRO_PRODUCT_ID=aab-v1

# 3. For Legacy Testing against cloud dev environment, update .env with:
#    USE_V2_CONTROL_PLANE=false
#    SSO_LOGIN_URL=https://sso.dev-godaddy.com/login
#    SSO_LOGOUT_URL=https://sso.dev-godaddy.com/logout
#    LOGIN_REDIRECT_URL=https://airo-builder.dev-godaddy.com/
#    LOGOUT_REDIRECT_URL=https://airo-builder.dev-godaddy.com/

# 4. Restart your development server after changing these values

# =============================================================================
# Why Different SSO Environments?
# =============================================================================

# mgmt-airo service is configured to work with sso.test-godaddy.com
# This is because mgmt-airo runs in the test environment and validates
# JWT tokens issued by sso.test-godaddy.com
#
# Legacy mode works with sso.dev-godaddy.com because it doesn't validate
# JWT tokens with external services - it only uses them for customer identification
#
# This dual SSO setup is temporary during the V2 migration period

# =============================================================================
# Container Orchestration (Nomad Configuration - Legacy Mode)
# =============================================================================

# Nomad API URL for container deployment
# Default: https://localhost:4646 (for local development with HTTPS)
# Production: Use your actual Nomad cluster API endpoint
# Only used when USE_V2_CONTROL_PLANE=false
NOMAD_API_URL=https://localhost:4646

# Nomad API timeout in milliseconds
# Default: 30000 (30 seconds)
# NOMAD_API_TIMEOUT=30000

# =============================================================================
# Database Configuration
# =============================================================================

# Development: SQLite database path for storing platform data (accounts, plans, etc.)
# Default: ./data/airo-builder-platform.db (relative to project root)
# Only used when NODE_ENV != 'production'
# DATABASE_PATH=./data/airo-builder-platform.db

# Production: MySQL RDS Configuration
# Used when NODE_ENV=production
# MySQL RDS endpoint hostname (replace with your RDS endpoint)
MYSQL_DB_PATH=placeholder-rds-host.region.rds.amazonaws.com

# MySQL RDS port (default: 3306)
MYSQL_DB_PORT=3306

# MySQL database name
MYSQL_DB_NAME=airo_builder

# MySQL credentials (store these in AWS Secrets Manager or environment)
# These should be retrieved from your secrets management system
MYSQL_DB_USERNAME=your-db-username
MYSQL_DB_PASSWORD=your-db-password

# =============================================================================
# AWS Configuration (for SQS-based Nomad job management)
# AWS Configuration
# =============================================================================

# AWS Region
# Default: eu-central-1
AWS_REGION=eu-central-1

# AWS Account ID
# Default: 418549769352 (dev account)
AWS_ACCOUNT_ID=418549769352

# S3 bucket for eval snapshot uploads (screenshot + manifest)
# Used by /api/eval-snapshots endpoint
EVAL_SNAPSHOTS_BUCKET=airo-eval-snapshots-dev

# S3 bucket for feedback submissions
# Used by /api/feedback/s3-store endpoint
# Set to airo-builder-feedback-dev for dev, airo-builder-feedback-prod for prod
# Leave unset in test env — S3 write is silently skipped when unset
FEEDBACK_BUCKET=airo-builder-feedback-dev

# Feedback fan-out — investigator Lambda invocation
# ARN of the AiroInvestigator Lambda (same Lambda as debug-console).
# Get the value from CDK output InvestigatorFnName after deploying AiroInvestigatorStack.
# Leave empty in local dev — fan-out is disabled when unset (guarded by appbuilder-feedback-fanout flag).
# INVESTIGATE_LAMBDA_FN=

# Bucket the BFF reads to detect an in-flight investigation for the
# fan-out lock check. Get the value from CDK output StateBucketName after
# deploying AiroInvestigatorStack. Leave empty in local dev — the lock
# check is silently skipped when unset and a fresh Lambda is invoked on
# every submit.
# INVESTIGATE_BUCKET=

# Public base URL of the debug-console for the current environment.
# Used by the feedback fan-out reuse path to build the investigate URL
# attached to deduplicated CRM cases (so support can follow a spam-click
# case back to the in-flight investigation).
# Mirrors the Lambda's DEBUG_CONSOLE_BASE_URL — set the same value here
# and on the investigator Lambda's CDK stack (cdk/lib/config.ts:
# debugConsoleBaseUrl) so all linked cases land on the same console
# screen.
#   pre-test / test → https://console.airo-builder.test-godaddy.com
#   prod-ecs        → https://console.airo-builder.godaddy.com
# Leave empty in local dev — the deduplication note is silently skipped
# when unset (the case is still filed; only the cross-link is missing).
# DEBUG_CONSOLE_BASE_URL=

# =============================================================================
# Pricing & Commerce Configuration
# =============================================================================

# Offer Graph API URL for pricing information
# Development: https://og.api.dev-godaddy.com/graphql
# Test: https://og.api.test-godaddy.com/graphql
# Production: https://og.api.godaddy.com/graphql
# Default: https://og.api.test-godaddy.com/graphql

# Legacy Mock Login Setting (DEPRECATED - Use AUTH_TYPE=mock instead)
# NEXT_PUBLIC_USE_MOCK_LOGIN=false

# =============================================================================
# Development Configuration
# =============================================================================

# Node environment
NODE_ENV=development

# =============================================================================
# Usage Instructions
# =============================================================================

# 1. Copy this file to .env.local:
#    cp env.example .env.local
#
# 2. Configure your OpenAI API key for AI features:
#    Set OPENAI_API_KEY=your-actual-api-key
#
# 3. Configure authentication URLs if using a different SSO provider
#
# 4. Set NEXT_PUBLIC_AUTH_IN_DEV=true if you want to test auth in development
#
# 5. No API URLs need to be configured - the system uses dynamic URLs from the database
#
# Note: Environment variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Never put sensitive secrets in NEXT_PUBLIC_ variables.

# Set this to development or test, which ensures corresponding ECR images is used for Nomad
ENVIRONMENT_NAME=development

# Set the NOMAD_SPEC_IMAGE_VERSION, the version of the agent and app image that the nomad spec should use
NOMAD_SPEC_IMAGE_VERSION=pre-dev-v1.0.0

# Budget Service (BFF -> BMS)
# BUDGET_SERVICE_URL=http://localhost:4200
