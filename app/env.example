# Airo AI Builder - Environment Configuration Example
# Copy this file to .env.local and configure the values for your environment

# =============================================================================
# API Configuration
# =============================================================================

# Base URL for the Airo AI Builder API backend
# Default: http://localhost:4000 (for local development)
# Production example: https://api.airo-builder.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# WebSocket URL for real-time communication with the agents
# Default: ws://localhost:4000 (for local development)
# Production example: wss://api.airo-builder.com
NEXT_PUBLIC_API_WS_URL=ws://localhost:4000

# =============================================================================
# Authentication Configuration (GoDaddy SSO)
# =============================================================================

# SSO Login URL
# Default: https://sso.test-godaddy.com/login
NEXT_PUBLIC_SSO_LOGIN_URL=https://sso.test-godaddy.com/login

# SSO Logout URL
# Default: https://sso.test-godaddy.com/logout
NEXT_PUBLIC_SSO_LOGOUT_URL=https://sso.test-godaddy.com/logout

# Login Redirect URL (where users go after successful login)
# Default: https://airo-builder.test-godaddy.com/
NEXT_PUBLIC_LOGIN_REDIRECT_URL=https://airo-builder.test-godaddy.com/

# Logout Redirect URL (where users go after logout)
# Default: https://airo-builder.test-godaddy.com/
NEXT_PUBLIC_LOGOUT_REDIRECT_URL=https://airo-builder.test-godaddy.com/

# Enable authentication in development
# Set to 'true' to enable auth in development mode, 'false' to bypass
# Default: false (auth is disabled in development)
NEXT_PUBLIC_AUTH_IN_DEV=false

# =============================================================================
# Development Configuration
# =============================================================================

# Node environment
NODE_ENV=development

# =============================================================================
# Usage Instructions
# =============================================================================

# 1. Copy this file to .env.local:
#    cp env.example .env.local
#
# 2. Update the API URLs to match your backend deployment:
#    - For local development, use http://localhost:4000
#    - For staging/production, use your actual API domain
#
# 3. Configure authentication URLs if using a different SSO provider
#
# 4. Set NEXT_PUBLIC_AUTH_IN_DEV=true if you want to test auth in development
#
# Note: Environment variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Never put sensitive secrets in NEXT_PUBLIC_ variables.
