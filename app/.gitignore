# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
junit-results.xml

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# certificates and private keys
*.key
certs/*.key
certs/*.p12
certs/*.pfx
certs/*.crt
certificates/*


# database files
/data/
*.db
*.db-wal
*.db-shm

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# dev log file (generated by load-env.js in local dev)
dev.log

# env files (can opt-in for committing if needed)
.env
.env.local
# Note: .env.local.{dev|test|prod} are NOT ignored - they're environment configs (no secrets)

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# App secrets storage (local development)
/app-secrets

# CDS generated ESM dependencies
/cds
