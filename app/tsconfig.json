{
  "compilerOptions": {
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "outDir": "dist",
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/gasket": ["./dist/gasket.js"],
      "@/*": ["src/*"],
      "@cds/*": ["cds/*"],
      "@cds/deps-esm": ["./cds/deps-esm.js"]
    },
    "allowJs": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": false
  },
  "exclude": ["node_modules"],
  "include": ["./plugins", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", ".next/dev/types/**/*.ts"]
}
