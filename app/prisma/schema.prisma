generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum SiteStatus {
  init
  creating
  created
  running
  stopped
  error
  failed
}

enum AccountStatus {
  active
  suspended
  closed
}

enum SocialPlatformType {
  FACEBOOK
  INSTAGRAM
  GOOGLE_BUSINESS_PROFILE
  TIKTOK
  YELP
  WHATSAPP
}

enum PostState {
  SCHEDULED
  PUBLISHED
  FAILED
}

model accounts {
  id          String        @id
  shopper_id  String        @unique
  customer_id String        @unique
  plan_id     String?
  status      AccountStatus @default(active)
  created_at  DateTime      @default(now())
  updated_at  DateTime      @default(now())
  sites       sites[]
}

model plans {
  id         String   @id
  name       String   @unique
  site_limit Int      @default(10)
  price      Decimal  @default(0.00)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
}

model sites {
  id              String     @id
  account_id      String
  title           String?
  initial_prompt  String?    @db.Text
  domain          String?
  agent_url       String?
  backend_url     String?
  preview_url     String?
  published_url   String?
  ceph_mount_id   String?
  ceph_dir_number String?
  status          SiteStatus @default(stopped)
  created_at      DateTime   @default(now())
  updated_at      DateTime   @default(now())
  account         accounts   @relation(fields: [account_id], references: [id], onDelete: Cascade)
  social_associations     social_associations[]
  social_posts        social_posts[]

  @@index([ceph_mount_id, ceph_dir_number])
  @@index([account_id])
}

model social_associations {
  id              String              @id @default(cuid())
  site_id         String
  social_id       String
  platform        SocialPlatformType
  created_at      DateTime            @default(now())
  site            sites               @relation(fields: [site_id], references: [id], onDelete: Cascade)
  social_posts    social_posts[]

  @@unique([site_id, social_id])
  @@index([site_id, platform])
  @@map("social_associations")
}

model social_posts {
  id                  String              @id @default(cuid())
  site_id             String
  association_id      String?
  platform            String
  state               PostState
  payload             Json
  external_response   Json?
  external_id         String?
  scheduled_at        DateTime?
  completed_at        DateTime?
  campaign_id         String?
  created_by          String?
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt
  site                sites               @relation(fields: [site_id], references: [id], onDelete: Cascade)
  association         social_associations? @relation(fields: [association_id], references: [id], onDelete: SetNull) // Preserve posts for historical/audit purposes when a social association is removed

  @@index([site_id])
  @@index([site_id, state])
  @@index([association_id])
  @@index([platform])
  @@index([scheduled_at])
  @@index([campaign_id])
}
