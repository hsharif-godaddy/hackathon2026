generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum SiteStatus {
  init
  creating
  created
  running
  stopped
  error
  failed
}

enum AccountStatus {
  active
  suspended
  closed
}

model accounts {
  id          String        @id
  shopper_id  String        @unique
  customer_id String        @unique
  plan_id     String?
  status      AccountStatus @default(active)
  created_at  DateTime      @default(now())
  updated_at  DateTime      @default(now())
  sites       sites[]
}

model plans {
  id         String   @id
  name       String   @unique
  site_limit Int      @default(10)
  price      Decimal  @default(0.00)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
}

model sites {
  id              String     @id
  account_id      String
  title           String?
  initial_prompt  String?    @db.Text
  domain          String?
  agent_url       String?
  backend_url     String?
  preview_url     String?
  ceph_mount_id   String?
  ceph_dir_number String?
  status          SiteStatus @default(stopped)
  created_at      DateTime   @default(now())
  updated_at      DateTime   @default(now())
  account         accounts   @relation(fields: [account_id], references: [id], onDelete: Cascade)

  @@index([ceph_mount_id, ceph_dir_number])
  @@index([account_id])
}
