{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run local",
    "dev:mysql": "node scripts/setup-database-url.js npm run local",
    "local": "concurrently \"npm run build:tsc:watch\" \"npm run local:https\" \"next dev\"",
    "local:https": "tsx watch server.ts",
    "prebuild": "prisma generate && tsx gasket.ts build",
    "build": "npm run build:tsc && next build",
    "build:tsc": "tsc -p ./tsconfig.server.json",
    "build:tsc:watch": "tsc -p ./tsconfig.server.json --watch",
    "start": "NODE_OPTIONS='--import @godaddy/gasket-otel/register' NEXT_OTEL_VERBOSE=1 npm run start:https & next start",
    "start:https": "node dist/server.js",
    "preview": "npm run build && npm run start",
    "start:mysql": "node scripts/setup-database-url.js next start",
    "start:server": "node scripts/setup-database-url.js node server.js",
    "setup-db": "node scripts/setup-database-url.js",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "install-gd-packages": "pnpm --registry https://gdartifactory1.jfrog.io/artifactory/api/npm/node-virt/ install @godaddy/gasket-plugin-auth"
  },
  "dependencies": {
