    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "^6.15.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@types/better-sqlite3": "^7.6.13",
    "@ux/box": "^2500.3.2",
    "@ux/button": "^2500.3.2",
    "@ux/disrupt": "^2500.3.3",
