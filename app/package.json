{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "GASKET_ENV=local.dev node ../scripts/load-env.js npm run local",
    "local:test": "GASKET_ENV=local.test node ../scripts/load-env.js npm run local",
    "local:test:v2": "GASKET_ENV=local.test node ../scripts/load-env.js npm run local",
    "local:prod": "GASKET_ENV=local.prod node ../scripts/load-env.js npm run local",
    "local:prod:v2": "GASKET_ENV=local.prod node ../scripts/load-env.js npm run local",
    "prelocal": "node scripts/generate-cds-deps.js",
    "local": "concurrently \"npm run build:tsc:watch\" \"npm run local:https\" \"next dev --webpack\"",
    "local:https": "tsx watch server.ts",
    "prebuild": "node scripts/generate-cds-deps.js && tsx gasket.ts build",
    "build": "npm run build:tsc && next build --webpack",
    "build:tsc": "tsc -p ./tsconfig.server.json",
    "build:tsc:watch": "tsc -p ./tsconfig.server.json --watch",
    "start": "npm run start:https & next start",
    "start:https": "node dist/server.js",
    "preview": "npm run build && npm run start",
    "test": "NODE_OPTIONS='--max-old-space-size=512' vitest run",
    "test:unit": "NODE_OPTIONS='--max-old-space-size=512' vitest run --exclude='**/*.integration.test.{ts,tsx}'",
    "test:integration": "NODE_OPTIONS='--max-old-space-size=512' vitest run .integration.test",
    "test:watch": "NODE_OPTIONS='--max-old-space-size=512' vitest",
    "test:ui": "NODE_OPTIONS='--max-old-space-size=512' vitest --ui",
    "test:coverage": "NODE_OPTIONS='--max-old-space-size=512' vitest run --coverage",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "generate:landing-lookup": "tsx src/data/landing-pages/generate-lookup.ts",
    "install-gd-packages": "pnpm --registry https://gdartifactory1.jfrog.io/artifactory/api/npm/node-virt/ install @godaddy/gasket-plugin-auth"
  },
