{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:mysql": "node scripts/setup-database-url.js next dev --turbopack",
    "build": "prisma generate && next build",
    "build:server": "tsc server.ts --outDir . --target es2020 --module commonjs --moduleResolution node --esModuleInterop --allowSyntheticDefaultImports",
    "start": "next start",
    "start:mysql": "node scripts/setup-database-url.js next start",
    "start:server": "node scripts/setup-database-url.js node server.js",
    "setup-db": "node scripts/setup-database-url.js",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "install-gd-packages": "pnpm --registry https://gdartifactory1.jfrog.io/artifactory/api/npm/node-virt/ install @godaddy/gasket-plugin-auth"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.679.0",
