    "@ux/menu": "^2500.3.3",
    "@ux/sibling-set": "^2500.3.3",
    "@ux/spinner": "^2500.3.2",
    "@ux/tag": "^2500.3.2",
    "@ux/tailwind-intents": "^2500.3.2",
    "@ux/text": "^2500.3.2",
    "better-sqlite3": "^12.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "elastic-apm-node": "^4.8.0",
    "execa": "^9.6.0",
    "gd-auth": "1.4.1",
    "immer": "^10.1.3",
    "lucide-react": "^0.540.0",
    "magic-string": "0.30.17",
    "monaco-editor": "^0.52.2",
    "mysql2": "^3.11.5",
