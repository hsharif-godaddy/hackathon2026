    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.18.12",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.10.0"
  }
}
