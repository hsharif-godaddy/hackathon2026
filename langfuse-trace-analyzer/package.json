{
  "name": "langfuse-trace-analyzer",
  "version": "0.1.0",
  "description": "Langfuse Metrics v1 API to Elasticsearch ingest pipeline for Kibana dashboards",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
