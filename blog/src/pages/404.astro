---
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

const homeUrl = `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title="404 | Inside Airo Builder" description="Page not found.">
  <SiteHeader />

  <section class="hero">
    <h1>Page not found</h1>
    <p class="tagline">This page does not exist or may have moved.</p>
  </section>

  <main class="content-wrapper" style="text-align: center;">
    <a href={homeUrl} class="read-more">&larr; Back to all posts</a>
  </main>

  <SiteFooter />
</BaseLayout>
