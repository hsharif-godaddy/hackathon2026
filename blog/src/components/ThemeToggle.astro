<div class="theme-toggle" role="group" aria-label="Color theme">
  <button type="button" class="theme-toggle__btn" data-theme-choice="system" aria-pressed="false">
    Auto
  </button>
  <button type="button" class="theme-toggle__btn" data-theme-choice="light" aria-pressed="false">
    Light
  </button>
  <button type="button" class="theme-toggle__btn" data-theme-choice="dark" aria-pressed="false">
    Dark
  </button>
</div>
<script is:inline>
  (function themeToggle() {
    const KEY = 'airo-blog-theme';
    const mq = window.matchMedia('(prefers-color-scheme: dark)');

    function storedPreference() {
      const s = localStorage.getItem(KEY);
      if (s === 'light' || s === 'dark') return s;
      return 'system';
    }

    function resolvedScheme() {
      const s = localStorage.getItem(KEY);
      if (s === 'light' || s === 'dark') return s;
      return mq.matches ? 'dark' : 'light';
    }

    function apply() {
      const scheme = resolvedScheme();
      document.documentElement.dataset.colorScheme = scheme;
      document.documentElement.style.colorScheme = scheme;
      const pref = storedPreference();
      document.querySelectorAll('.theme-toggle__btn').forEach(function (btn) {
        const choice = btn.getAttribute('data-theme-choice');
        btn.setAttribute('aria-pressed', choice === pref ? 'true' : 'false');
      });
    }

    function init() {
      const group = document.querySelector('.theme-toggle');
      if (!group) return;

      apply();

      group.addEventListener('click', function (e) {
        const t = e.target;
        if (!(t instanceof HTMLElement) || !t.matches('.theme-toggle__btn')) return;
        const choice = t.getAttribute('data-theme-choice');
        if (choice === 'light') localStorage.setItem(KEY, 'light');
        else if (choice === 'dark') localStorage.setItem(KEY, 'dark');
        else localStorage.removeItem(KEY);
        apply();
      });

      mq.addEventListener('change', function () {
        if (storedPreference() === 'system') apply();
      });

      window.addEventListener('storage', function (e) {
        if (e.key === KEY) apply();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
