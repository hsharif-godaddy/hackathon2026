---
import type { CollectionEntry } from 'astro:content';
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, category, heroImage } = post.data;
const canonicalPath = `${import.meta.env.BASE_URL}/${post.slug}/`;
const imagePath = `${import.meta.env.BASE_URL}${heroImage ?? '/images/og-default.svg'}`;
const imageUrl = new URL(imagePath, Astro.site ?? new URL(Astro.url.origin)).toString();
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  author: {
    '@type': 'Organization',
    name: 'Airo Builder Team',
  },
  dateModified: (updatedDate ?? pubDate).toISOString(),
  datePublished: pubDate.toISOString(),
  headline: title,
  image: [imageUrl],
  isPartOf: {
    '@type': 'Blog',
    name: 'Inside Airo Builder',
  },
  keywords: category ? [category] : undefined,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(canonicalPath, Astro.site ?? new URL(Astro.url.origin)).toString(),
  },
  publisher: {
    '@type': 'Organization',
    logo: {
      '@type': 'ImageObject',
      url: imageUrl,
    },
    name: 'GoDaddy Airo Builder',
  },
  url: new URL(canonicalPath, Astro.site ?? new URL(Astro.url.origin)).toString(),
  description,
};

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
}
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  ogType="article"
  ogImagePath={imagePath}
  jsonLd={articleJsonLd}
>
  <SiteHeader />

  <main class="content-wrapper">
    <article class="post-content">
      <header style="text-align: center; margin-bottom: 3rem;">
        <p class="post-meta">
          <time datetime={pubDate.toISOString()}>
            {formatDate(pubDate)}
          </time>
          {category && (
            <>
              {' · '}
              <span class="category">{category}</span>
            </>
          )}
        </p>
        <h1>{title}</h1>
        {updatedDate && (
          <p class="post-meta" style="margin-top: 0.5rem;">
            Updated: <time datetime={updatedDate.toISOString()}>
              {formatDate(updatedDate)}
            </time>
          </p>
        )}
      </header>
      <div class="prose">
        <slot />
      </div>
      <footer style="margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--color-border);">
        <a href={`${import.meta.env.BASE_URL}/`} class="read-more">&larr; Back to all posts</a>
      </footer>
    </article>
  </main>

  <SiteFooter />

  <div id="lightbox" role="dialog" aria-modal="true" aria-label="Image preview" aria-hidden="true" tabindex="-1">
    <img id="lightbox-img" src="" alt="" />
  </div>
</BaseLayout>

<style is:global>
  #lightbox {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.88);
    z-index: 1000;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    cursor: zoom-out;
  }

  #lightbox.active {
    display: flex;
  }

  #lightbox img {
    max-width: 100%;
    max-height: 90vh;
    object-fit: contain;
    border-radius: 0.5rem;
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.6);
    cursor: zoom-out;
    margin: 0;
  }

  article.post-content .prose img {
    cursor: zoom-in;
  }
</style>

<script>
  const overlayEl = document.getElementById('lightbox');
  const lightboxImgEl = document.getElementById('lightbox-img');

  if (overlayEl && lightboxImgEl instanceof HTMLImageElement) {
    const overlay: HTMLElement = overlayEl;
    const lightboxImg: HTMLImageElement = lightboxImgEl;

    let lastTrigger: HTMLElement | null = null;

    function openLightbox(img: HTMLImageElement): void {
      lightboxImg.src = img.src;
      lightboxImg.alt = img.alt;
      lastTrigger = img;
      overlay.classList.add('active');
      overlay.setAttribute('aria-hidden', 'false');
      overlay.focus();
    }

    function closeLightbox(): void {
      overlay.classList.remove('active');
      overlay.setAttribute('aria-hidden', 'true');
      lastTrigger?.focus();
      lastTrigger = null;
    }

    document.querySelectorAll('.prose img').forEach((img) => {
      const el = img as HTMLImageElement;
      el.setAttribute('tabindex', '0');
      el.setAttribute('role', 'button');
      el.setAttribute('aria-haspopup', 'dialog');
      el.addEventListener('click', () => openLightbox(el));
      el.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openLightbox(el);
        }
      });
    });

    overlay.addEventListener('click', () => {
      closeLightbox();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeLightbox();
      }
    });
  }
</script>
