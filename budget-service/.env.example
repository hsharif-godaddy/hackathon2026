# budget-service/.env.example

# Service
PORT=8080
LOG_LEVEL=info

# Database
DATABASE_URL=postgres://user:password@localhost:5432/budget_service?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# Auth
AUTH_JWKS_URL=https://sso.godaddy.com/.well-known/jwks.json
AUTH_S2S_KEYS=agents-service:secret,admin-api:secret

# Logging
AUDIT_LOG_PATH=/var/log/budget-service/audit.log

# Alerts
ALERT_WARNING_THRESHOLD=20
ALERT_CRITICAL_THRESHOLD=10
