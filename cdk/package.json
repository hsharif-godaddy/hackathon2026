{
  "name": "airo-builder-cdk",
  "version": "0.1.0",
  "bin": {
    "cdk": "bin/app.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "cdk",
    "build:lambdas": "npx tsx lambda/build.ts --all",
