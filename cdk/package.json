    "verify:lambdas": "npx tsx lambda/build.ts --all && npx tsx lambda/verify.ts"
  },
  "devDependencies": {
    "@types/node": "^22.18.12",
    "aws-cdk": "^2.1115.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1023.0",
    "@gd-safeguard/godaddy-constructs": "^11.0.1",
    "aws-cdk-lib": "^2.245.0",
    "constructs": "^10.6.0",
    "esbuild": "^0.27.4"
  }
}
