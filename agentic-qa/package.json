{
  "name": "agentic-qa",
  "version": "1.0.0",
  "description": "AI-powered QA testing framework for Airo Builder using Stagehand",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "tsx src/index.ts",
    "test:all": "tsx src/index.ts --all",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "dependencies": {
    "@browserbasehq/stagehand": "^3.0.8",
    "@elastic/elasticsearch": "^8.19.1",
    "dotenv": "^16.4.7",
    "yaml": "^2.7.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.12",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.10.0"
  }
}
