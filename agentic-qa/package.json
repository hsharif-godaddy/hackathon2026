{
  "name": "agentic-qa",
  "version": "1.0.0",
  "description": "AI-powered QA testing framework for Airo Builder using Stagehand",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx/esm --test 'src/**/*.test.ts'",
    "test:e2e": "tsx src/index.ts",
    "test:e2e:all": "tsx src/index.ts --all",
    "test:e2e:quality": "tsx src/index.ts --quality-only",
    "test:unit": "node --import tsx/esm --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'no linter configured'",
    "lint:fix": "echo 'no linter configured'"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@browserbasehq/stagehand": "^3.1.0",
    "@elastic/elasticsearch": "catalog:",
    "dotenv": "catalog:",
    "lighthouse": "^12.0.0",
    "playwright": "^1.40.0",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "assume": "^2.3.0",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
