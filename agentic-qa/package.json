{
  "name": "agentic-qa",
  "version": "1.0.0",
  "description": "AI-powered QA testing framework for Airo Builder using Stagehand",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "pnpm test:unit",
    "test:e2e": "tsx src/index.ts",
    "test:e2e:all": "tsx src/index.ts --all",
    "test:e2e:quality": "tsx src/index.ts --quality-only",
    "test:unit": "node --import tsx/esm --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'no linter configured'",
    "lint:fix": "echo 'no linter configured'"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@browserbasehq/stagehand": "^3.0.8",
    "@elastic/elasticsearch": "^8.19.1",
    "dotenv": "^16.4.7",
    "lighthouse": "^12.0.0",
    "playwright": "^1.40.0",
    "yaml": "^2.7.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.12",
    "assume": "^2.3.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.10.0"
  }
}
