# Knowledge Service - Environment Configuration
# Copy to .env and fill in required values

# Service
PORT=8081
LOG_LEVEL=info

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_COLLECTION=knowledge_base
QDRANT_API_KEY=
QDRANT_USE_TLS=false
QDRANT_TLS_SKIP_VERIFY=false

# OpenAI (Embeddings + LLM) - via GoCode proxy
OPENAI_API_KEY=
OPENAI_BASE_URL=https://caas-gocode-prod.caas-prod.prod.onkatana.net
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSION_FAST=256
EMBEDDING_DIMENSION_PRECISE=1024

# LLM (Contextual Retrieval)
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=200

# Auth
# Auth mode: "jwt" (default, validates tokens), "none" (bypasses auth, for local dev)
# For local development, set AUTH_TYPE=none to bypass JWT validation
AUTH_TYPE=jwt
SSO_HOST=sso.test-godaddy.com
# Ingest endpoint requires an AWS IAM token (service-to-service only via gdcorp-golang/auth)

# Search defaults
SEARCH_TOP_N=8
SEARCH_PREFETCH_LIMIT=100
SEARCH_PREFETCH_THRESHOLD=0.15
SEARCH_FUSION_LIMIT=50
SEARCH_OVERSAMPLING=2.5

# LLM-enhanced search (HyDE + multi-query). Disabled by default to avoid
# LLM latency overhead; enable when GoCode S2S is configured.
SEARCH_LLM_ENHANCED=false
SEARCH_QUERY_REWRITE_MODEL=gpt-4o-mini
SEARCH_QUERY_REWRITE_MAX_TOKENS=150
SEARCH_QUERY_REWRITE_TIMEOUT_MS=2000

# Score calibration (sigmoid mapping raw scores to 0.0-1.0 confidence)
SEARCH_CONFIDENCE_THRESHOLD=0.2
SEARCH_CALIBRATION_MIDPOINT=0.30
SEARCH_CALIBRATION_STEEPNESS=6.0

# Ingest
INGEST_BATCH_SIZE=100
INGEST_MIN_CHUNK_SIZE=400
INGEST_MAX_CHUNK_SIZE=3200
INGEST_CHUNK_OVERLAP=320

# HTTP Server timeouts (seconds)
HTTP_READ_TIMEOUT=30
HTTP_WRITE_TIMEOUT=60
HTTP_IDLE_TIMEOUT=120
# Search-specific deadline. With SEARCH_LLM_ENHANCED=true, HyDE + multi-query
# adds ~1-2s of LLM latency; increase if GoCode proxy is slow.
HTTP_SEARCH_TIMEOUT=15

# Rate limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_RPS=50
