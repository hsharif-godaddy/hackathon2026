.DS_Store

# npmrc files with Artifactory auth tokens are written at CI time into
# several dirs for Lambda builds — never commit them.
.npmrc
cdk/lambda/*/.npmrc
investigator/.npmrc

# Dependencies
node_modules
.pnpm-store/
cdk/package-lock.json
__pycache__/
*.pyc

agents/fixtures/atlas-job-corpus.local.json

# Local clone of gdcorp-golang/auth (needed for Go replace directives)
/auth

# e2e pool-app id cache, written by the pool-resolve setup project each run
tests/.pool-cache.json

# Build outputs
dist/
build/
*.tsbuildinfo
.docker-cache/
storybook-static/

# Turborepo
.turbo/

# Log directories (but not internal/logs/ or supportplane/logs/ source code)
logs/
!**/internal/logs/
!**/supportplane/logs/

# Log files
agent.log
app.log
messages-*


# Playwright Test Artifacts
test-results/
playwright-report/
tests/.auth/
*.png
