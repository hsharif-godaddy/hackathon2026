!docs/**/*.png
!app/public/images/*.png
*.webm
*.mp4
app/test-results/
app/playwright-report/
.playwright-cli/

# Design Extractor Output
packages/design-extractor/output/

.env
.env.*

# Untracked direnv overrides (loaded by .envrc; written by `pnpm run sandbox:on`)
.envrc.local


# Development CA (per-project certificate authority)
.dev-ca/

# mTLS client certs (local dev)
**/certs/*.crt
**/certs/*.key

# BMS dev seed state (written by dev-runner preflight)
.dev-bms/

# License reports
licenses-report.txt
.direnv/CACHEDIR.TAG
keys/jwt-private.pem
keys/jwt-public.pem

