.DS_Store

# Dependencies
node_modules
.pnpm-store/
cdk/package-lock.json
__pycache__/
*.pyc

# Local clone of gdcorp-golang/auth (needed for Go replace directives)
/auth

# Build outputs
dist/
build/
*.tsbuildinfo
.docker-cache/

# Turborepo
.turbo/

# Log directories (but not internal/logs/ source code)
logs/
!**/internal/logs/

# Log files
agent.log
app.log
messages-*


# Playwright Test Artifacts
test-results/
playwright-report/
*.png
!blog/public/images/*.png
*.webm
*.mp4
app/test-results/
app/playwright-report/
.playwright-cli/

# Design Extractor Output
packages/design-extractor/output/

.env
.env.*


# Development CA (per-project certificate authority)
.dev-ca/

# License reports
licenses-report.txt
.direnv/CACHEDIR.TAG
keys/jwt-private.pem
keys/jwt-public.pem

# IDE specific files
.idea/
.cursor/debug-*.log

proxy-logs/

.claude/settings.local.json
.superpowers/

# Git worktrees
.worktrees/
.claude/worktrees/

# Local control plane ad-hoc server binary (see local-control-plane/.gitignore; enforced in .husky/pre-commit)
local-control-plane/server

# GoDaddy Golden Container Image metadata (fetch from s3://gd-goldenami-prod-ecr-repolist/gci-metadata.json)
gci-metadata.json
all.log
.claude/skills/
