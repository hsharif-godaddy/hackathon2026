{
  "compilerOptions": {
    "target": "es2020",
    "module": "es2020",
    "moduleResolution": "node",
    "lib": ["es2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false,
    "allowImportingTsExtensions": false,
    "noEmit": false
  },
  "include": [
    "src/server/**/*",
    "src/lib/**/*"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist",
    "src/app/**/*",
    "src/components/**/*",
    "src/hooks/**/*"
  ]
}
