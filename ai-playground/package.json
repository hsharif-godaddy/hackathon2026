    "lucide-react": "^0.544.0",
    "multer": "^2.0.2",
    "nanoid": "^5.1.5",
    "next": "15.5.3",
    "openmeteo": "^1.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-dropzone": "^14.3.8",
    "react-syntax-highlighter": "^15.6.6",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "streamdown": "^1.2.0",
    "tailwind-merge": "^3.3.1",
