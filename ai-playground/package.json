{
  "name": "ai-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "tsx src/server/setup.ts",
    "dev": "tsx watch src/server/index.ts",
    "build": "next build && npm run build:server",
    "build:server": "tsc --project tsconfig.server.json",
    "start": "npm run build && node dist/server/index.js",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.server.json --noEmit",
    "lint": "eslint",
    "clean": "rm -rf dist .next"
  },
  "dependencies": {
