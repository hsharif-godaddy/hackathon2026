# API keys for LLM services
OPENAI_API_KEY=sk-your-openai-api-key

# Environment configuration
APPS_BASE_DIR=/tmp/apps  # Base directory for app storage
APP_TEMPLATE_DIR=app-templates/v3  # Template directory

# Deployment mode (Docker or Local)
# DOC_APPS=true  # Set to true for Docker mode, false for local mode

# Port configuration
PORT=4000  # Server port

# Token usage display settings
SHOW_USAGE_COST=false

# Getty Images API configuration
SSO_JWT=your-sso-jwt-token
GETTY_API_URL=https://getty-images-proxy.api.test-godaddy.com/v1/search
GETTY_APP_KEY=airo-app-builder