# API keys for LLM services
OPENAI_API_KEY=sk-your-openai-api-key

# Environment configuration
APPS_BASE_DIR=/tmp/apps  # Base directory for app storage
APP_TEMPLATE_DIR=app-templates/v8  # Template directory

# Port configuration
PORT=4000  # Server port

# Token usage display settings
SHOW_USAGE_COST=false

# Getty Images API configuration
SSO_JWT=your-sso-jwt-token
GETTY_API_URL=https://getty-images-proxy.api.test-godaddy.com/v1/search
GETTY_APP_KEY=airo-app-builder

# Airo client cert (deploy-only; not needed for local dev). When unset, the
# CRM-case-on-feedback flow is treated as disabled — the BFF returns 403
# feature-disabled and the feedback UX is unaffected. Both must be set for
# the feature to activate; ops injects them as Katana secrets in test/prod.
# AIRO_CLIENT_CERT=
# AIRO_CLIENT_KEY=
# AIRO_SSO_ENDPOINT=https://sso.test-godaddy.com/v1/secure/api/token  # default: same
# PROFILE_API_BASE=https://profile.api.int.test-godaddy.com
# CRM_API_BASE=https://crm.int.test-godaddy.com