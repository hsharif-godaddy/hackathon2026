{
  "name": "@airo/notification-service",
  "version": "0.1.0",
  "description": "Kinesis event consumer that sends templated email notifications via the messaging API",
  "type": "module",
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm exec eslint src/",
    "lint:fix": "pnpm exec eslint --fix src/"
  },
  "dependencies": {
    "@aws-sdk/client-kinesis": "^3.1075.0",
    "@switchboard/client": "^2.7.0",
    "gd-auth-client": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@airo/eslint-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20.10.0"
  }
}
