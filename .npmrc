registry=https://gdartifactory1.jfrog.io/artifactory/api/npm/node-virt/
replace-registry-host=always

# Hoist @babel/runtime to make it accessible to @ux packages that require it
public-hoist-pattern[]=@babel/runtime

# Use catalog versions by default when adding deps via pnpm add
catalog-mode=prefer

# Supply-chain hardening: quarantine newly published packages for 7 days
# (matches Dependabot cooldown.default-days in .github/dependabot.yml).
minimum-release-age=10080
# Only bypass quarantine for scopes our team publishes and controls end-to-end.
# Broader GoDaddy scopes (@godaddy/*, @ux/*, gd-auth, etc.) stay quarantined —
# their publishing credentials are outside this team's control, so defense-in-depth
# applies. If a Dependabot bump blocks here, that's the 7-day cooldown working.
minimum-release-age-exclude=@airo/*,@airo-ux/*

# Reject transitive deps using git:/tarball specifiers.
block-exotic-subdeps=true