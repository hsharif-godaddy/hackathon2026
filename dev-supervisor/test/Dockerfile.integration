FROM golang:1.25-alpine AS builder
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o dev-supervisor .

FROM alpine:3.22
RUN apk add --no-cache bash curl procps
COPY --from=builder /build/dev-supervisor /usr/local/bin/dev-supervisor
COPY test/docker-integration-tests.sh /test/
RUN chmod +x /test/docker-integration-tests.sh /usr/local/bin/dev-supervisor
ENTRYPOINT ["/usr/local/bin/dev-supervisor"]
