FROM rust:1.96-alpine AS rust-builder
# Route linking through cc so /usr/lib and /usr/lib/gcc/... are searched
# (proc-macro / build-script compiles need libgcc_s, libc, libgcc).
# Overrides the rust-lld setting in rust/.cargo/config.toml for this
# Alpine native build only; final binary stays statically linked.
RUN apk add --no-cache musl-dev gcc
ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_LINKER=cc
ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_MUSL_LINKER=cc
WORKDIR /build
COPY rust/ ./rust/
RUN cd rust && cargo build --release && \
    cp target/release/airo-workspace /usr/local/bin/airo-workspace

FROM golang:1.25-alpine AS go-builder
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /usr/local/bin/dev-supervisor ./cmd/dev-supervisor && \
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /usr/local/bin/airo-sandbox ./cmd/airo-sandbox

FROM alpine:3.22
RUN apk add --no-cache bash curl procps
COPY --from=rust-builder /usr/local/bin/airo-workspace /usr/local/bin/airo-workspace
COPY --from=go-builder /usr/local/bin/dev-supervisor /usr/local/bin/dev-supervisor
COPY --from=go-builder /usr/local/bin/airo-sandbox /usr/local/bin/airo-sandbox
COPY test/docker-integration-tests.sh /test/
RUN chmod +x /test/docker-integration-tests.sh
# Opt the integration test into the strangler topology — the whole point of
# this Dockerfile is to validate the airo-workspace -> dev-supervisor proxy
# end-to-end. Production deployments leave this unset until PR #4 moves the
# peer-sec auth check into Rust.
ENV AIRO_WORKSPACE_PROXY=1
ENTRYPOINT ["/usr/local/bin/airo-workspace", "/usr/local/bin/dev-supervisor"]
