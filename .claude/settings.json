{
  "permissions": {
    "deny": [
      "Edit(**/node_modules/**)",
      "Edit(**/dist/**)",
      "Edit(**/.next/**)",
      "Edit(**/.turbo/**)",
      "Write(**/node_modules/**)",
      "Write(**/dist/**)",
      "Write(**/.next/**)",
      "Write(**/.turbo/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/post-edit-lint.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/worktree-create.sh",
            "timeout": 600,
            "statusMessage": "Creating worktree (env files, deps)..."
          }
        ]
      }
    ]
  }
}
