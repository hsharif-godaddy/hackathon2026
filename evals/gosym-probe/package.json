{
  "name": "gosym-probe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "eval": "tsx --env-file=.env src/index.ts",
    "save-baseline": "tsx --env-file=.env src/save-baseline.ts",
    "prompt-tax-compare": "tsx src/prompt-tax-compare.ts",
    "prompt-tax-rescore": "tsx --env-file=.env src/prompt-tax-rescore.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ config/",
    "lint:fix": "eslint --fix src/ config/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@airo/ai-lib": "workspace:*",
    "@aws-sdk/client-s3": "^3.1049.0",
    "chalk": "^5.6.2",
    "eventsource": "^4.1.0",
    "openai": "catalog:",
    "playwright": "^1.59.1",
    "undici": "^8.2.0",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@airo/eslint-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
