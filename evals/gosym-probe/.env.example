# Environment selection — controls which config/environments/*.ts is loaded.
# Valid values: local.dev | local.test | local.prod
# Defaults to local.dev when unset.
GD_ENV=local.dev

# GoCode (OpenAI-compatible) endpoint.
# Use the GoDaddy GoCode URL for your environment.
OPENAI_BASE_URL=

# API key for the GoCode endpoint.
OPENAI_API_KEY=

# Model to use via GoCode.
OPENAI_MODEL=claude-sonnet-4-6

# Maximum concurrent trials / parallel scenarios.
# Overrides the per-environment config default.
# --concurrency CLI flag takes priority over this.
# MAX_CONCURRENCY=2

# Maximum turns per simulation before the loop is forced to stop.
# Overrides the per-environment config default (30).
# --max-turns CLI flag takes priority over this.
# MAX_TURNS=30

# AWS SSO profile used by both AAB and GoCode.
# Run `aws sso login --profile airobuild-dev-private-sso` before starting.
AWS_PROFILE=airobuild-dev-private-sso

# Set to 1 to print every inbound AAB socket event to stderr.
# Format: [aab] {type} {toolName}  (tool name only for tool_* events)
# Useful for verifying what events arrive during handoff chains.
# PROBE_DEBUG_EVENTS=1
