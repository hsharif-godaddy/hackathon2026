{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["siteType", "requiredElements"],
  "properties": {
    "siteType": {
      "type": "string",
      "enum": [
        "ecommerce",
        "restaurant",
        "portfolio",
        "blog",
        "landing-page",
        "service-business",
        "nonprofit",
        "medical",
        "legal",
        "fitness",
        "event-planner",
        "generic"
      ],
      "description": "Type of website being evaluated"
    },
    "requiredElements": {
      "type": "array",
      "description": "Elements that must be present for this site type",
      "items": {
        "type": "string"
      }
    },
    "optionalElements": {
      "type": "array",
      "description": "Optional elements that add value",
      "items": {
        "type": "string"
      }
    }
  }
}
