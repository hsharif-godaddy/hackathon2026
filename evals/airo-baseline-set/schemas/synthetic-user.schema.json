{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "airo-baseline-set/schemas/synthetic-user.schema.json",
  "title": "Airo Baseline Synthetic User",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "type",
    "syntheticId",
    "persona"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "syntheticId": {
      "type": "string",
      "pattern": "^syn_[a-z0-9]+$"
    },
    "persona": {
      "$ref": "#/$defs/persona"
    }
  },
  "$defs": {
    "persona": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "coreTraits",
        "decisionPattern",
        "communicationStyle"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "coreTraits": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "decisionPattern": { "type": "string", "minLength": 1 },
        "communicationStyle": {
          "$ref": "#/$defs/communicationStyle"
        },
        "rejectionTriggers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "acceptanceTriggers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "exitTriggers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "retryTriggers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "communicationStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formality", "detailLevel", "technicalLevel", "examples"],
      "properties": {
        "formality": { "type": "string", "minLength": 1 },
        "detailLevel": { "type": "string", "minLength": 1 },
        "technicalLevel": { "type": "string", "minLength": 1 },
        "examples": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
