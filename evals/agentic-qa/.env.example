# Agentic QA Environment Variables

# GoDaddy Test Account Credentials
TEST_USERNAME=your-test-username
TEST_PASSWORD=your-test-password

# AI Provider Configuration - GoDaddy GoCode proxy (OpenAI-compatible)
OPENAI_API_KEY=your-gocode-api-key
OPENAI_BASE_URL=https://caas-gocode-prod.caas-prod.prod.onkatana.net/v1
ANTHROPIC_MODEL=claude-sonnet-4

# Alternative: Direct OpenAI API
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_MODEL=gpt-4o
