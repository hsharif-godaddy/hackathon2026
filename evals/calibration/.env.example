LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://agentobser-langfuse.int.godaddy.com

# DynamoDB config (Synthia tables)
DDB_REGION=
SYNTHIA_SCENARIOS_TABLE=synthia-scenarios
SYNTHIA_SCENARIOS_PK_NAME=scenarioId
SYNTHIA_SIMULATIONS_TABLE=synthia-simulations
SYNTHIA_SIMULATIONS_PK_NAME=taskId
SYNTHIA_SIMULATIONS_STATUS_NAME=status
SYNTHIA_SIMULATIONS_TIME_FIELDS=createdAt,startedAt,timestamp,createdAtMs,startedAtMs
SYNTHIA_SIMULATIONS_AGENT_ID=
SYNTHIA_SIMULATIONS_AGENT_ID_NAME=agentId
SYNTHIA_SIMULATIONS_COMPLETED_AT_NAME=completedAt
SYNTHIA_SIMULATIONS_SCENARIO_ID_NAME=scenarioId

SYNTHIA_EVALUATIONS_TABLE=synthia-evaluations
SYNTHIA_EVALUATIONS_GSI1_NAME=GSI1
SYNTHIA_EVALUATIONS_GSI1_PK_NAME=simulationId

# Logging: silent | info | debug
CALIBRATION_LOG_LEVEL=info

# Site capture
CAPTURE_MAX_ROUTES=20
CAPTURE_IGNORE_HTTPS_ERRORS=false

# LLM judge calls (GoCaaS / OpenAI-compatible proxy)
GOCAAS_BASE_URL=
GOCAAS_API_KEY=

# Models
# Diverse judge panel: comma-separated, distinct model FAMILIES (no personas; diversity is the
# whole point). Add a third family (e.g. a Gemini id) once confirmed available on GOCAAS_BASE_URL.
JUDGE_MODELS=gpt-5.2,claude-sonnet-4-6
# Advisory meta-judge — use a strong, different-family model so the auditor isn't the same family
# as the panel majority. Opus is a good choice. Leave unset to auto-pick a non-first-judge family.
JUDGE_META_MODEL=claude-opus-4-8
# Back-compat (used only when JUDGE_MODELS is unset):
JUDGE_MODEL_GPT=gpt-5.2
JUDGE_MODEL_SONNET=claude-sonnet-4-6
