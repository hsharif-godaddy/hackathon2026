{
  "name": "airo-app-builder-root",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "scripts": {
    "dev": "cd dev-runner && make build && exec ./dist/dev-runner",
    "clean": "cd dev-runner && make build && ./dist/dev-runner clean",
    "dev:legacy": "pnpm --parallel --filter @airo/agents --filter website dev",
    "dev:control-plane": "cd local-control-plane && exec make run",
    "local:test": "pnpm --parallel --filter @airo/agents --filter website local:test",
    "local:prod": "pnpm --parallel --filter @airo/agents --filter website local:prod",
    "dev:agents": "pnpm --filter @airo/agents dev",
    "dev:app": "pnpm --filter website dev",
    "storybook": "pnpm --filter @airo-ux/pattern-library storybook",
    "storybook:build": "pnpm --filter @airo-ux/pattern-library storybook:build",
    "build": "turbo run build --filter=@airo/shared --filter=@airo-ux/pattern-library --filter=@airo/ai-common --filter=@airo/ai-grants --filter=@airo/ai-lib --filter=@airo/ai-transport --filter=@airo/ai-skills --filter=@airo/agents --filter=website",
    "build:all": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "./scripts/test.sh",
    "test:e2e": "./scripts/e2e.sh",
    "e2e:v2:test": "./scripts/e2e.sh --env=test --project=e2e-v2",
    "e2e:v2:test:headed": "./scripts/e2e.sh --env=test --project=e2e-v2 --headed",
    "e2e:v2:cleanup": "PLAYWRIGHT_ENV=test playwright test --project=e2e-v2-setup && node tests/scripts/cleanup-orphaned-apps.mjs --env=test",
    "e2e:v2:cleanup:dry-run": "PLAYWRIGHT_ENV=test playwright test --project=e2e-v2-setup && node tests/scripts/cleanup-orphaned-apps.mjs --env=test --dry-run",
    "pr-check": "./scripts/pr-check.sh",
    "pr-check:quick": "./scripts/pr-check.sh --quick",
    "validate:i18n:ci": "bash scripts/validate-i18n-ci.sh",
    "prepare": "husky && husky install",
    "apm:start": "./scripts/local-apm.sh start",
    "apm:stop": "./scripts/local-apm.sh stop",
    "apm:status": "./scripts/local-apm.sh status",
    "apm:logs": "./scripts/local-apm.sh logs",
    "apm:clean": "./scripts/local-apm.sh clean",
    "runtime:sandbox:setup": "./scripts/container-runtime/lima/manage.sh setup",
    "runtime:sandbox:teardown": "./scripts/container-runtime/lima/manage.sh teardown",
    "runtime:sandbox:status": "./scripts/container-runtime/lima/manage.sh status",
    "sandbox:on": "./scripts/container-runtime/sandbox-flag.sh on",
    "sandbox:off": "./scripts/container-runtime/sandbox-flag.sh off",
    "sandbox:status": "./scripts/container-runtime/sandbox-flag.sh status",
    "release": "cd release-manager && make build && ./dist/release-manager"
  },
  "devDependencies": {
    "@babel/generator": "catalog:",
    "@babel/parser": "catalog:",
    "@babel/traverse": "catalog:",
    "@babel/types": "catalog:",
    "@elastic/elasticsearch": "catalog:",
    "@playwright/test": "^1.59.1",
    "@testla/cli": "0.6.4",
    "gray-matter": "catalog:",
    "husky": "^8.0.3",
    "lint-staged": "^15.5.2",
    "prettier": "catalog:",
    "turbo": "^2.9.14"
  },
  "lint-staged": {
    "agents/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter @airo/agents lint:fix"
    ],
    "app/**/*.{ts,tsx,js,jsx}": [
      "bash -c 'cd app && pnpm lint --fix'",
      "node scripts/validate-i18n.mjs"
    ],
    "packages/ai-lib/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter @airo/ai-lib lint:fix"
    ],
    "packages/ai-common/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter @airo/ai-common lint:fix"
    ],
    "packages/ai-grants/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter @airo/ai-grants lint:fix"
    ],
    "packages/ai-transport/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter @airo/ai-transport lint:fix"
    ],
    "packages/ai-skills/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter @airo/ai-skills lint:fix"
    ],
    "packages/pattern-library/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter @airo-ux/pattern-library lint:fix"
    ],
    "website/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter website lint --fix"
    ],
    "*.{md,yml,yaml}": [
      "bash -c 'if [[ \"$0\" != *\"pnpm-lock.yaml\" ]] && [[ \"$0\" != *\"agents/src/skills/\"* ]] && [[ \"$0\" != *\"agents/src/prompts/\"* ]]; then prettier --write \"$0\"; fi'"
    ],
    "*.json": [
      "bash -c 'if [[ \"$0\" != *\"pnpm-lock.json\" ]]; then prettier --write \"$0\"; fi'"
    ]
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "@sso/deck>react-intl": "7",
        "@ux/tailwind-intents>tailwindcss": "4",
        "ai-tokenizer>ai": "6",
        "openai>zod": "4"
      }
    },
    "overrides": {
      "axios": "^1.16.0",
      "chai": "5.3.1",
      "caniuse-lite": "1.0.30001736",
      "devalue": ">=5.8.1",
      "dotenv": "17.2.3",
      "eslint": "9.28.0",
      "glob": ">=10.5.0 <11 || >=11.1.0",
      "hono": "4.12.21",
      "js-cookie": ">=3.0.7",
      "jsdom": "26.1.0",
      "langsmith": "0.6.1",
      "next": "16.2.6",
      "prettier": "3.4.2",
      "qs": "6.15.2",
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "vite": "6.4.2",
      "vitest": "4.1.0",
      "@ux/alert": "2500.11.1",
      "@ux/box": "2500.9.0",
      "@ux/button": "2500.11.1",
      "@ux/card": "2500.11.1",
      "@ux/checkbox": "2500.11.1",
      "@ux/coachmark": "2500.11.1",
      "@ux/collapsible": "2500.11.4",
      "@ux/disrupt": "2500.11.1",
      "@ux/flyout": "2500.11.1",
      "@ux/growl": "2500.11.1",
      "@ux/icon": "2500.11.0",
      "@ux/intents": "2500.9.0",
      "@ux/menu": "2500.11.1",
      "@ux/modal": "2500.11.1",
      "@ux/pagination": "2500.11.1",
      "@ux/radio": "2500.9.0",
      "@ux/select": "2500.11.1",
      "@ux/select-input": "2500.11.1",
      "@ux/skeleton": "2500.11.1",
      "@ux/space": "2500.9.0",
      "@ux/spinner": "2500.9.0",
      "@ux/table": "2500.11.1",
      "@ux/tag": "2500.11.0",
      "@ux/tailwind-intents": "2500.9.0",
      "@ux/text": "2500.9.0",
      "@ux/text-input": "2500.11.1",
      "@ux/toggle-button": "2500.11.1",
      "@ux/tooltip": "2500.11.1",
      "basic-ftp": ">=5.2.0",
      "fast-xml-parser": ">=5.3.5",
      "fastify": ">=5.7.2",
      "fast-uri": ">=3.1.2",
      "koa": ">=2.16.4 <3",
      "thrift": ">=0.23.0",
      "protobufjs": ">=8.0.2",
      "@opentelemetry/sdk-node": ">=0.217.0",
      "@opentelemetry/auto-instrumentations-node": ">=0.75.0",
      "@opentelemetry/exporter-prometheus": ">=0.217.0",
      "postcss": ">=8.5.10 <9",
      "prismjs": ">=1.30.0 <2",
      "shell-quote": ">=1.8.4 <2",
      "ws": ">=8.21.0 <9"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ],
    "ignoredBuiltDependencies": [
      "duckdb"
    ]
  },
  "dependencies": {
    "dotenv": "catalog:"
  }
}
