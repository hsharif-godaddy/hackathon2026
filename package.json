{
  "name": "airo-app-builder-root",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.17.0+sha512.fce8a3dd29a4ed2ec566fb53efbb04d8c44a0f05bc6f24a73046910fb9c3ce7afa35a0980500668fa3573345bd644644fa98338fa168235c80f4aa17aa17fbef",
  "scripts": {
    "dev": "concurrently \"pnpm --filter @airo/agents dev\" \"pnpm --filter website dev\"",
    "local:test": "concurrently \"pnpm --filter @airo/agents local:test\" \"pnpm --filter website local:test\"",
    "local:prod": "concurrently \"pnpm --filter @airo/agents local:prod\" \"pnpm --filter website local:prod\"",
    "dev:agents": "pnpm --filter @airo/agents dev",
    "dev:app": "pnpm --filter website dev",
    "dev:setup": "pnpm --filter airo-setup dev",
    "build": "pnpm --filter \"@airo/*\" build && pnpm --filter website build",
    "build:all": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "prepare": "husky && husky install",
    "apm:start": "./scripts/local-apm.sh start",
    "apm:stop": "./scripts/local-apm.sh stop",
    "apm:status": "./scripts/local-apm.sh status",
    "apm:logs": "./scripts/local-apm.sh logs",
    "apm:clean": "./scripts/local-apm.sh clean"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "concurrently": "^9.1.2",
    "husky": "^8.0.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.0.0"
  },
  "lint-staged": {
    "agents/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter @airo/agents lint:fix"
    ],
    "app/**/*.{ts,tsx,js,jsx}": [
      "bash -c 'cd app && pnpm lint'",
      "bash -c 'cd app && case \"${SKIP_PRECOMMIT_TESTS,,}\" in 1|true|yes) ;; *) pnpm test ;; esac'"
    ],
    "proxy/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter proxy lint:fix"
    ],
    "packages/ai-lib/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter ai-lib lint:fix"
    ],
    "website/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter website lint"
    ],
    "*.{md,yml,yaml}": [
      "bash -c 'if [[ \"$0\" != *\"pnpm-lock.yaml\" ]]; then prettier --write \"$0\"; fi'"
    ],
    "*.json": [
      "bash -c 'if [[ \"$0\" != *\"pnpm-lock.json\" ]]; then prettier --write \"$0\"; fi'"
    ]
  },
  "pnpm": {
    "overrides": {
      "chai": "5.3.1",
      "caniuse-lite": "1.0.30001736",
      "next": "14.2.35",
      "qs": "6.14.1",
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "@ux/alert": "2500.7.2",
      "@ux/box": "2500.7.1",
      "@ux/button": "2500.7.2",
      "@ux/card": "2500.7.2",
      "@ux/checkbox": "2500.7.2",
      "@ux/coachmark": "2500.7.2",
      "@ux/collapsible": "2500.7.2",
      "@ux/disrupt": "2500.7.2",
      "@ux/flyout": "2500.7.1",
      "@ux/growl": "2500.7.2",
      "@ux/icon": "2500.7.2",
      "@ux/intents": "2500.7.1",
      "@ux/menu": "2500.7.2",
      "@ux/modal": "2500.7.2",
      "@ux/pagination": "2500.7.2",
      "@ux/radio": "2500.7.1",
      "@ux/select": "2500.7.2",
      "@ux/select-input": "2500.7.2",
      "@ux/skeleton": "2500.7.2",
      "@ux/spinner": "2500.7.1",
      "@ux/table": "2500.7.2",
      "@ux/tag": "2500.7.2",
      "@ux/tailwind-intents": "2500.7.1",
      "@ux/text": "2500.7.1",
      "@ux/text-input": "2500.7.2",
      "@ux/toggle-button": "2500.7.1",
      "@ux/tooltip": "2500.7.2"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ],
    "ignoredBuiltDependencies": [
      "duckdb"
    ]
  },
  "dependencies": {
    "agents": "^0.3.6",
    "dotenv": "^17.2.3",
    "xml2js": "^0.6.2"
  }
}
