{
  "name": "airo-app-builder-root",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.17.0+sha512.fce8a3dd29a4ed2ec566fb53efbb04d8c44a0f05bc6f24a73046910fb9c3ce7afa35a0980500668fa3573345bd644644fa98338fa168235c80f4aa17aa17fbef",
  "scripts": {
    "dev": "pnpm --parallel --filter @airo/agents --filter website dev",
    "local:test": "pnpm --parallel --filter @airo/agents --filter website local:test",
    "local:prod": "pnpm --parallel --filter @airo/agents --filter website local:prod",
    "dev:agents": "pnpm --filter @airo/agents dev",
    "dev:app": "pnpm --filter website dev",
    "dev:setup": "pnpm --filter airo-setup dev",
    "build": "turbo run build --filter=@airo/shared --filter=@airo/ai-common --filter=@airo/ai-grants --filter=@airo/ai-lib --filter=@airo/ai-transport --filter=@airo/ai-skills --filter=@airo/agents --filter=website",
    "build:all": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "./scripts/test.sh",
    "test:e2e": "playwright test",
    "prepare": "husky && husky install",
    "apm:start": "./scripts/local-apm.sh start",
    "apm:stop": "./scripts/local-apm.sh stop",
    "apm:status": "./scripts/local-apm.sh status",
    "apm:logs": "./scripts/local-apm.sh logs",
    "apm:clean": "./scripts/local-apm.sh clean"
  },
  "devDependencies": {
    "@elastic/elasticsearch": "^8.19.1",
    "@playwright/test": "^1.56.1",
    "husky": "^8.0.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.0.0",
    "turbo": "^2.8.17"
  },
  "lint-staged": {
    "agents/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter @airo/agents lint:fix"
    ],
    "app/**/*.{ts,tsx,js,jsx}": [
      "bash -c 'cd app && pnpm lint --fix'"
    ],
    "proxy/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter proxy lint:fix"
    ],
    "packages/ai-lib/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter @airo/ai-lib lint:fix"
    ],
    "packages/ai-common/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter @airo/ai-common lint:fix"
    ],
    "packages/ai-grants/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter @airo/ai-grants lint:fix"
    ],
    "packages/ai-transport/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter @airo/ai-transport lint:fix"
    ],
    "packages/ai-skills/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter @airo/ai-skills lint:fix"
    ],
    "website/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter website lint --fix"
    ],
    "*.{md,yml,yaml}": [
      "bash -c 'if [[ \"$0\" != *\"pnpm-lock.yaml\" ]]; then prettier --write \"$0\"; fi'"
    ],
    "*.json": [
      "bash -c 'if [[ \"$0\" != *\"pnpm-lock.json\" ]]; then prettier --write \"$0\"; fi'"
    ]
  },
  "pnpm": {
    "overrides": {
      "@typescript-eslint/eslint-plugin": "8.54.0",
      "@typescript-eslint/parser": "8.54.0",
      "@vitest/ui": "3.2.4",
      "chai": "5.3.1",
      "caniuse-lite": "1.0.30001736",
      "dotenv": "17.2.3",
      "eslint": "8.57.1",
      "eslint-config-prettier": "9.1.0",
      "glob": ">=10.5.0 <11 || >=11.1.0",
      "hono": "4.11.7",
      "next": "14.2.35",
      "prettier": "3.4.2",
      "qs": "6.14.1",
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "typescript": "5.9.2",
      "vite": "6.4.1",
      "vitest": "3.2.4",
      "@ux/alert": "2500.7.2",
      "@ux/box": "2500.7.1",
      "@ux/button": "2500.7.2",
      "@ux/card": "2500.7.2",
      "@ux/checkbox": "2500.7.2",
      "@ux/coachmark": "2500.7.2",
      "@ux/collapsible": "2500.7.2",
      "@ux/disrupt": "2500.7.2",
      "@ux/flyout": "2500.7.1",
      "@ux/growl": "2500.7.2",
      "@ux/icon": "2500.7.2",
      "@ux/intents": "2500.7.1",
      "@ux/menu": "2500.7.2",
      "@ux/modal": "2500.7.2",
      "@ux/pagination": "2500.7.2",
      "@ux/radio": "2500.7.1",
      "@ux/select": "2500.7.2",
      "@ux/select-input": "2500.7.2",
      "@ux/skeleton": "2500.7.2",
      "@ux/spinner": "2500.7.1",
      "@ux/table": "2500.7.2",
      "@ux/tag": "2500.7.2",
      "@ux/tailwind-intents": "2500.7.1",
      "@ux/text": "2500.7.1",
      "@ux/text-input": "2500.7.2",
      "@ux/toggle-button": "2500.7.1",
      "@ux/tooltip": "2500.7.2",
      "basic-ftp": ">=5.2.0",
      "fast-xml-parser": ">=5.3.5"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ],
    "ignoredBuiltDependencies": [
      "duckdb"
    ]
  },
  "dependencies": {
    "dotenv": "^17.2.3"
  }
}
