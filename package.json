{
  "name": "airo-app-builder-root",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.17.0+sha512.fce8a3dd29a4ed2ec566fb53efbb04d8c44a0f05bc6f24a73046910fb9c3ce7afa35a0980500668fa3573345bd644644fa98338fa168235c80f4aa17aa17fbef",
  "scripts": {
    "dev": "concurrently \"pnpm --filter @airo/agents dev\" \"pnpm --filter website dev\"",
    "dev:agents": "pnpm --filter @airo/agents dev",
    "dev:app": "pnpm --filter website dev",
    "dev:setup": "pnpm --filter airo-setup dev",
    "build": "pnpm --filter \"@airo/*\" build && pnpm --filter website build",
    "build:all": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "prepare": "husky && husky install"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "concurrently": "^9.1.2",
    "husky": "^8.0.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.0.0"
  },
  "lint-staged": {
    "agents/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter @airo/agents lint:fix"
    ],
    "app/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter app lint"
    ],
    "proxy/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter proxy lint:fix"
    ],
    "packages/ai-lib/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter ai-lib lint:fix"
    ],
    "app-templates/v8/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter v8-template lint:fix"
    ],
    "website/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter website lint"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "package.json": [
      "bash -c 'MATRIX_PACKAGE=root ./scripts/license-check.sh'"
    ],
    "app/package.json": [
      "bash -c 'cd app && MATRIX_PACKAGE=app ../../scripts/license-check.sh'"
    ],
    "proxy/package.json": [
      "bash -c 'cd proxy && MATRIX_PACKAGE=proxy ../scripts/license-check.sh'"
    ],
    "packages/ai-lib/package.json": [
      "bash -c 'cd packages/ai-lib && MATRIX_PACKAGE=ai-lib ../../../scripts/license-check.sh'"
    ],
    "app-templates/v8/package.json": [
      "bash -c 'cd app-templates/v8 && MATRIX_PACKAGE=v8-template ../../../scripts/license-check.sh'"
    ],
    "website/package.json": [
      "bash -c 'cd website && MATRIX_PACKAGE=website ../../scripts/license-check.sh'"
    ]
  },
  "pnpm": {
    "overrides": {
      "chai": "5.3.1",
      "caniuse-lite": "1.0.30001736",
      "react": "19.1.0",
      "react-dom": "19.1.0"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ],
    "ignoredBuiltDependencies": [
      "duckdb"
    ]
  }
}
