# Bedrock Log Viewer Configuration

# Server Configuration
PORT=3001
AWS_REGION=us-west-2

# S3 Polling Configuration (optional)
S3_POLLING_ENABLED=true
S3_BUCKET_NAME=airo-builder-bedrock-logs
S3_PREFIX=AWSLogs/694282668781/BedrockModelInvocationLogs/us-west-2/
S3_POLL_INTERVAL=*/10 * * * *
S3_MAX_FILES_PER_POLL=50

# Database Configuration
DB_PATH=./bedrock_logs.duckdb