{
  "name": "bedrock-log-viewer",
  "version": "2.0.0",
  "description": "An enhanced webapp to download, store, and analyze AWS Bedrock logs from S3",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && cp src/database/schema.sql dist/database/",
    "dev": "pnpm run build && node dist/server.js",
    "start": "node dist/server.js",
    "dev:watch": "tsc -w & nodemon dist/server.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.1",
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "node-cron": "^3.0.3",
    "zlib": "^1.0.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.18.12",
    "@types/node-cron": "^3.0.11",
    "nodemon": "^3.1.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "aws",
    "bedrock",
    "logs",
    "s3",
    "analysis",
    "duckdb",
    "typescript"
  ],
  "author": "",
  "license": "ISC"
}
